        }
      },
      "callerKinds": [
        "anonymous",
        "identified"
      ],
      "principalRequires": [],
      "bindings": []
    },
    "publishArticle": {
      "access": {
        "kind": "identity",
        "identity": "reader",
        "schemes": [
          "bearer"
        ],
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/app/routes/articles/member/routes/publish/identity"
        }
      },
      "callerKinds": [
        "identified"
      ],
      "principalRequires": [],
      "bindings": []
    }
  }
