{
  "name": "@seampact/codegen-yup",
  "description": "Seampact validators for yup: Standard Schema validators per schema and direction, and one input validator per operation.",
  "license": "MIT",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/targets/codegen-yup"
  },
  "homepage": "https://jubasse.github.io/seampact/configuration/validators/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "keywords": [
    "yup",
    "validation",
    "standard-schema",
    "seampact",
    "api-contract",
    "openapi",
    "codegen"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*",
    "yup": "1.7.1"
  }
}
