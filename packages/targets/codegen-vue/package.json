{
  "name": "@seampact/codegen-vue",
  "description": "Generates TanStack Query or Pinia Colada options and Vue composables, or plain fetch composables with no query library, over the typed fetch client, with keys, invalidation and paging read from the contract.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@pinia/colada": ">=1.4 <2",
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*",
    "@tanstack/vue-query": ">=5.90 <6",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@pinia/colada": {
      "optional": true
    },
    "@tanstack/vue-query": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  }
}
