{
  "name": "@seampact/codegen-adonis",
  "description": "Generates the AdonisJS boundary around your controllers: the routes of each api with their checking middleware, the reply path, the error helpers for your exception handler and a boot check, validating with the zod or yup link you give or with VineJS validators it generates.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "runtime"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@adonisjs/core": "7.6.0",
    "@adonisjs/core-6": "npm:@adonisjs/core@6.21.0",
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*",
    "@types/node": "24.19.1",
    "@vinejs/vine": "4.4.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
