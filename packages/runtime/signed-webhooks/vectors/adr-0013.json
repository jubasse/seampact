{
  "description": "The test vectors of ADR 0013 'Test vectors', G1 to G3 and S1 to S9; S10 and S11 are boundary cases (the hook is not called).",
  "schemes": {
    "github": {
      "format": "sha256={sig}",
      "algorithm": "hmac-sha256",
      "payload": "{rawBody}",
      "encoding": "hex"
    },
    "stripe": {
      "format": "t={ts},v1={sig}",
      "algorithm": "hmac-sha256",
      "payload": "{ts}.{rawBody}",
      "encoding": "hex",
      "toleranceMs": 300000
    },
    "stripeBase64": {
      "format": "t={ts},v1={sig}",
      "algorithm": "hmac-sha256",
      "payload": "{ts}.{rawBody}",
      "encoding": "base64",
      "toleranceMs": 300000
    }
  },
  "cases": [
    {
      "id": "G1",
      "scheme": "github",
      "secrets": ["It's a Secret to Everybody"],
      "body": "Hello, World!",
      "header": "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17",
      "expected": "pass"
    },
    {
      "id": "G2",
      "scheme": "github",
      "secrets": ["gh_seampact_test_secret"],
      "body": "{\"action\":\"opened\",\"number\":42}",
