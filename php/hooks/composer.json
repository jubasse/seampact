{
  "name": "seampact/hooks",
  "description": "The Seampact hook interfaces, decision and subject types for PHP: what generated boundaries call and applications implement.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3.36 <8.4 || >=8.4.27 <8.5 || >=8.5.12"
  },
  "require-dev": {
    "phpstan/phpstan": "2.2.16",
    "phpunit/phpunit": "11.5.56"
  },
  "autoload": {
    "psr-4": {
      "Seampact\\Hooks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Seampact\\Hooks\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.36"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
