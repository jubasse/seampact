{
  "name": "seampact/laravel",
  "description": "The Seampact Laravel target: generates the FormRequests, types, controller interfaces and routes of a contract for Laravel 13.",
  "type": "library",
  "license": "MIT",
  "require": {
    "ext-json": "*",
    "php": ">=8.3.36 <8.4 || >=8.4.27 <8.5 || >=8.5.12",
    "nette/php-generator": "~4.2.0",
    "seampact/codegen": "self.version",
    "seampact/ir": "self.version"
  },
  "require-dev": {
    "laravel/framework": "13.38.0",
    "phpstan/phpstan": "2.2.16",
    "phpunit/phpunit": "11.5.56",
    "seampact/hooks": "self.version"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../codegen",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../ir",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../hooks",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "Seampact\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Seampact\\Laravel\\Runtime\\": "runtime/",
      "Seampact\\Laravel\\Tests\\": "tests/",
      "Seampact\\Golden\\": "tests/golden/"
    }
  },
  "extra": {
    "seampact": {
      "generator": "Seampact\\Laravel\\LaravelGenerator"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.36"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
