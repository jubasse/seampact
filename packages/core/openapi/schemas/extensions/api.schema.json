{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seampact.dev/schemas/openapi/extensions/api.schema.json",
  "title": "x-seampact-api",
  "description": "The api a document describes: its kind, role and caller.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "caller": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "right": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["identity", "right"],
      "additionalProperties": false
    }
  },
  "required": ["kind"],
  "additionalProperties": false
}
