        "layer": "shared",
        "pointer": "/identities/user"
      }
    },
    "service": {
      "id": "service",
      "kind": "credential",
      "schemes": {
        "read": [
          "internalToken"
        ],
        "write": [
          "internalToken"
        ],
        "optionalRead": []
      },
      "principal": {
        "kind": "schema",
        "schema": "ServicePrincipal"
      },
      "errors": [],
      "headers": [
        {
          "header": "deadline",
          "for": "all",
