{
  "name": "@seampact/codegen-vue",
  "description": "Seampact target for Vue: generates TanStack Query or Pinia Colada options and composables, or plain fetch composables, over the typed fetch client.",
  "license": "MIT",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/targets/codegen-vue"
  },
  "homepage": "https://jubasse.github.io/seampact/frontend/vue/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "keywords": [
    "vue",
    "client",
    "tanstack-query",
    "pinia-colada",
    "seampact",
    "api-contract",
    "openapi",
    "codegen"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@pinia/colada": ">=1.4 <2",
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*",
    "@tanstack/vue-query": ">=5.90 <6",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@pinia/colada": {
      "optional": true
    },
    "@tanstack/vue-query": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  }
}
