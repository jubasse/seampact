{
  "name": "@seampact/signed-webhooks",
  "description": "Verifies a template-signed webhook (HMAC, timestamp tolerance, secret rotation) inside an authenticate hook.",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/runtime/signed-webhooks"
  },
  "homepage": "https://jubasse.github.io/seampact/concepts/packages/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "helper"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@seampact/hooks": "workspace:*"
  }
}
