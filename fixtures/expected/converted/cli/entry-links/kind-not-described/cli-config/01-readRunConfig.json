{
  "function": "readRunConfig",
  "args": [
    "<root>/seampact.config.yaml",
    "seampact.config.yaml",
    null
  ],
  "result": {
    "status": "read",
    "run": {
      "kind": "app",
      "config": {
        "file": "<root>/seampact.config.yaml",
        "outDir": "<root>/__generated__",
        "sources": {
          "a": {
            "kind": "path",
            "directory": "<root>/a"
          }
        },
        "entries": [
          {
            "entry": {
              "id": "shared",
              "use": "probe-provider",
              "api": "tasks"
            },
            "root": "<root>/__generated__/shared"
          },
          {
            "entry": {
              "id": "server",
              "use": "probe-server",
              "api": "tasks",
              "link": {
                "validators": "shared"
              }
            },
            "root": "<root>/__generated__/server"
          }
        ]
      }
    }
  }
}
