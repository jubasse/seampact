{
  "name": "@seampact/lint",
  "description": "Lint rules over the IR, and the API to write your own.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "seampact": {
    "role": "core"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@seampact/compiler": "workspace:*",
    "@seampact/spec": "workspace:*"
  }
}
