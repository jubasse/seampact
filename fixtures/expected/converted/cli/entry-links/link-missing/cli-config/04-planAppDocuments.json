{
  "function": "planAppDocuments",
  "args": [
    {
      "file": "<root>/seampact.config.yaml",
      "outDir": "<root>/__generated__",
      "sources": {
        "a": {
          "kind": "path",
          "directory": "<root>/a"
        }
      },
      "entries": [
        {
          "entry": {
            "id": "client",
            "use": "probe-client",
            "api": "tasks"
          },
          "root": "<root>/__generated__/client"
        }
      ]
    },
    {
      "client": "client"
    },
    [
      {
        "source": "a",
        "api": "tasks",
        "documents": [
          "full",
          "public"
        ]
      }
    ]
  ],
  "result": {
    "status": "planned",
    "documents": []
  }
}
