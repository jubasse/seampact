{
  "name": "@seampact/compiler",
  "description": "Reads the YAML contract, reports errors with file, line and column, and produces the IR.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "core"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@seampact/spec": "workspace:*",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
