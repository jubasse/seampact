{
  "name": "@seampact/codegen-core",
  "description": "The API the code generators are written against.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src/node-server/runtime"
  ],
  "main": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node-server": {
        "types": "./dist/node-server/index.d.ts",
        "default": "./dist/node-server/index.js"
      }
    }
  },
  "seampact": {
    "role": "core"
  },
  "dependencies": {
    "@seampact/spec": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@seampact/hooks": "workspace:*",
    "prettier": "3.9.10"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node-server": "./src/node-server/index.ts"
  }
}
