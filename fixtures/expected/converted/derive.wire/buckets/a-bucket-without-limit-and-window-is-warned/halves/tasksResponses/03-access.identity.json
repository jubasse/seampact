          "origin": {
            "layer": "shared",
            "pointer": "/identities/service/headers/deadline"
          }
        },
        {
          "header": "trace",
          "for": "all",
          "required": false,
          "origin": {
            "layer": "shared",
            "pointer": "/identities/service/headers/trace"
          }
        },
        {
          "header": "actorSurface",
          "for": "writes",
          "required": true,
          "schema": {
            "kind": "enum",
            "enum": "Surface"
          },
          "origin": {
            "layer": "shared",
            "pointer": "/identities/service/headers/actorSurface"
          }
        }
      ],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "shared",
        "pointer": "/identities/service"
      }
    },
    "stripe": {
      "id": "stripe",
      "kind": "signed",
      "signed": "stripeSignature",
      "principal": {
        "kind": "schema",
        "schema": "WebhookCaller"
      },
      "errors": [],
      "headers": [],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "shared",
        "pointer": "/identities/stripe"
      }
    }
  },
