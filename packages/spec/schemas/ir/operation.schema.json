{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seampact.dev/schemas/ir/operation.schema.json",
  "title": "seampact IR: the operation",
  "description": "The httpOperation declaration kind (ADR 0004 section 7).",
  "$defs": {
    "HttpMethod": {
      "type": "string",
      "x-seampact-known": ["get", "post", "put", "patch", "delete"]
    },
    "CallerKind": { "type": "string", "x-seampact-known": ["anonymous", "identified"] },
    "OperationRef": {
      "type": "object",
      "description": "A kind-tagged operation reference (ADR 0014).",
      "required": ["kind", "api", "id"],
      "properties": {
        "kind": { "$ref": "common.schema.json#/$defs/DeclarationKind" },
        "api": { "type": "string" },
        "id": { "$ref": "common.schema.json#/$defs/OperationId" }
      }
    },
    "QueryWire": {
      "type": "object",
      "description": "The wire form of a query parameter (FR-30).",
      "required": ["kind", "style", "explode", "brackets"],
      "properties": {
        "kind": {
          "type": "string",
          "x-seampact-known": ["number", "boolean", "list", "text", "object"]
        },
        "style": { "type": "string", "x-seampact-known": ["form", "deepObject"] },
        "explode": { "type": "boolean" },
        "brackets": { "type": "boolean", "description": "A list sent as 'name[]'." }
      }
    },
    "FieldWire": {
      "type": "object",
      "description": "The wire form of a form or multipart field: a query wire form (style, explode and brackets set), or kind 'file' or 'json' alone.",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "x-seampact-known": ["number", "boolean", "list", "text", "object", "file", "json"]
        },
        "style": { "type": "string", "x-seampact-known": ["form", "deepObject"] },
        "explode": { "type": "boolean" },
        "brackets": { "type": "boolean" }
      }
    },
    "Param": {
      "type": "object",
      "description": "A path, query or header parameter, declared (origin) or derived (derivedFrom).",
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "required": { "type": "boolean" },
        "wire": { "$ref": "#/$defs/QueryWire" },
        "default": {},
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "Params": {
      "type": "object",
      "required": ["path", "query", "header"],
      "properties": {
        "path": { "type": "array", "items": { "$ref": "#/$defs/Param" } },
        "query": { "type": "array", "items": { "$ref": "#/$defs/Param" } },
        "header": { "type": "array", "items": { "$ref": "#/$defs/Param" } }
      }
    },
    "UnknownQuery": {
      "type": "object",
      "description": "Undeclared query keys.",
      "discriminator": { "propertyName": "policy" },
      "oneOf": [{ "$ref": "#/$defs/RefuseUnknownQuery" }, { "$ref": "#/$defs/IgnoreUnknownQuery" }]
    },
    "RefuseUnknownQuery": {
      "type": "object",
      "required": ["policy"],
      "properties": { "policy": { "type": "string", "const": "refuse" } }
    },
    "IgnoreUnknownQuery": {
      "type": "object",
      "required": ["policy", "reason", "origin"],
      "properties": {
        "policy": { "type": "string", "const": "ignore" },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Access": {
      "type": "object",
      "description": "Who may call the operation.",
      "discriminator": { "propertyName": "kind" },
      "oneOf": [
        { "$ref": "#/$defs/IdentityAccess" },
        { "$ref": "#/$defs/OptionalAccess" },
        { "$ref": "#/$defs/PublicAccess" }
      ]
    },
    "IdentityAccess": {
      "type": "object",
      "required": ["kind", "identity", "schemes", "origin"],
      "properties": {
        "kind": { "type": "string", "const": "identity" },
        "identity": { "$ref": "common.schema.json#/$defs/IdentityId" },
        "schemes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/SchemeId" } },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "OptionalAccess": {
      "type": "object",
      "required": ["kind", "identity", "schemes", "reason", "onRefused", "origin"],
      "properties": {
        "kind": { "type": "string", "const": "optional" },
        "identity": { "$ref": "common.schema.json#/$defs/IdentityId" },
        "schemes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/SchemeId" } },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "onRefused": { "type": "string", "x-seampact-known": ["anonymous", "reject"] },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "PublicAccess": {
      "type": "object",
      "required": ["kind", "reason", "origin"],
      "properties": {
        "kind": { "type": "string", "const": "public" },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "PrincipalRequirement": {
      "type": "object",
      "required": ["field", "origin"],
      "properties": {
        "field": { "type": "string" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "ScopeSource": {
      "type": "object",
      "description": "A value source, or 'resolver: true' alone.",
      "properties": {
        "in": { "$ref": "common.schema.json#/$defs/ValueSourceIn" },
        "name": { "type": "string" },
        "prefixBits": { "type": "integer", "minimum": 0, "maximum": 128 },
        "resolver": { "type": "boolean" }
      }
    },
    "OperationScope": {
      "type": "object",
      "required": ["scope", "source", "origin"],
      "properties": {
        "scope": { "$ref": "common.schema.json#/$defs/ScopeId" },
        "source": { "$ref": "#/$defs/ScopeSource" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Requirement": {
      "type": "object",
      "description": "A requirement, in declared order (FR-5).",
      "discriminator": { "propertyName": "kind" },
      "oneOf": [{ "$ref": "#/$defs/RightRequirement" }, { "$ref": "#/$defs/RuleRequirement" }]
    },
    "RequirementSubject": {
      "type": "object",
      "required": ["source", "defaulted"],
      "properties": {
        "source": { "$ref": "common.schema.json#/$defs/ValueSource" },
        "defaulted": { "type": "boolean" }
      }
    },
    "RightRequirement": {
      "type": "object",
      "required": ["kind", "right"],
      "properties": {
        "kind": { "type": "string", "const": "right" },
        "right": { "$ref": "common.schema.json#/$defs/RightId" },
        "params": { "description": "Values already validated against the right's params schema." },
        "subject": { "$ref": "#/$defs/RequirementSubject" },
        "entry": {
          "type": "string",
          "description": "The 'requirements' entry it was written through."
        },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "RuleRequirement": {
      "type": "object",
      "required": ["kind", "rule"],
      "properties": {
        "kind": { "type": "string", "const": "rule" },
        "rule": { "$ref": "common.schema.json#/$defs/RuleId" },
        "params": { "description": "Values already validated against the rule's params schema." },
        "bucket": { "$ref": "common.schema.json#/$defs/BucketId" },
        "entry": {
          "type": "string",
          "description": "The 'requirements' entry it was written through."
        },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "Binding": {
      "type": "object",
      "required": ["from", "to", "origin"],
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/ValueSource" },
        "to": { "$ref": "common.schema.json#/$defs/ValueSource" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "InputField": {
      "type": "object",
      "required": ["name", "wire"],
      "properties": { "name": { "type": "string" }, "wire": { "$ref": "#/$defs/FieldWire" } }
    },
    "OperationInput": {
      "type": "object",
      "description": "The request body.",
      "required": ["media", "schema", "bodyLimitBytes", "rawBody", "origin"],
      "properties": {
        "media": {
          "type": "string",
          "x-seampact-known": [
            "application/json",
            "application/x-www-form-urlencoded",
            "multipart/form-data"
          ]
        },
        "schema": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "bodyLimitBytes": { "type": "integer", "minimum": 0 },
        "rawBody": { "type": "boolean" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/InputField" } },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "ResponseHeader": {
      "type": "object",
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "required": { "type": "boolean" },
        "semantic": { "type": "string" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "Response": {
      "type": "object",
      "description": "A success or derived non-error response.",
      "required": ["status", "shape", "headers"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "media": { "type": "string", "description": "Absent for an empty body." },
        "body": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "shape": {
          "type": "string",
          "x-seampact-known": ["item", "table", "list", "page", "empty", "binary", "redirect"]
        },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/ResponseHeader" } },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "OperationError": {
      "type": "object",
      "description": "A code the operation can answer, declared or derived.",
      "required": ["code"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/ErrorCode" },
        "example": {},
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "FieldSubjectSource": {
      "type": "object",
      "description": "A value source, or 'holderField' alone.",
      "properties": {
        "in": { "$ref": "common.schema.json#/$defs/ValueSourceIn" },
        "name": { "type": "string" },
        "prefixBits": { "type": "integer", "minimum": 0, "maximum": 128 },
        "holderField": { "type": "string" }
      }
    },
    "FieldRightSubject": {
      "type": "object",
      "required": ["source"],
      "properties": { "source": { "$ref": "#/$defs/FieldSubjectSource" } }
    },
    "FieldRight": {
      "type": "object",
      "description": "A field right, materialised so targets never walk schemas (FR-23).",
      "required": ["schema", "pointer", "right", "direction", "derivedFrom"],
      "properties": {
        "schema": { "$ref": "common.schema.json#/$defs/SchemaId" },
        "pointer": { "type": "string" },
        "right": { "$ref": "common.schema.json#/$defs/RightId" },
        "params": {},
        "subject": { "$ref": "#/$defs/FieldRightSubject" },
        "direction": { "$ref": "common.schema.json#/$defs/Direction" },
        "inputPolicy": { "type": "string", "x-seampact-known": ["reject", "strip"] },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "Idempotency": {
      "type": "object",
      "description": "Either the derived key settings (header, replayHeader, lifetimeMs, required, enforce, derivedFrom) or an exemption (exempt, origin).",
      "properties": {
        "header": { "type": "string" },
        "replayHeader": { "type": "string" },
        "lifetimeMs": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" },
        "enforce": { "type": "string", "x-seampact-known": ["boundary", "none"] },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" },
        "exempt": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Concurrency": {
      "type": "object",
      "required": ["version", "field", "derivedFrom"],
      "properties": {
        "version": { "$ref": "common.schema.json#/$defs/ValueSource" },
        "field": { "type": "string" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "Owner": {
      "type": "object",
      "required": ["kind", "origin"],
      "properties": {
        "kind": { "type": "string", "x-seampact-known": ["caller"] },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "CacheDirectives": {
      "type": "object",
      "required": ["maxAgeMs", "immutable", "noCache", "mustRevalidate"],
      "properties": {
        "maxAgeMs": { "type": "integer", "minimum": 0 },
        "sharedMaxAgeMs": { "type": "integer", "minimum": 0 },
        "staleWhileRevalidateMs": { "type": "integer", "minimum": 0 },
        "staleIfErrorMs": { "type": "integer", "minimum": 0 },
        "immutable": { "type": "boolean" },
        "noCache": { "type": "boolean" },
        "mustRevalidate": { "type": "boolean" }
      }
    },
    "CallerCacheControl": {
      "type": "object",
      "required": ["caller", "cacheControl"],
      "properties": {
        "caller": { "$ref": "#/$defs/CallerKind" },
        "cacheControl": { "type": "string" }
      }
    },
    "Cache": {
      "type": "object",
      "description": "Cache settings (ADR 0004 section 7).",
      "required": ["family", "anonymous", "vary", "etag", "perCallerKind", "noStore", "origin"],
      "properties": {
        "family": { "type": "string" },
        "directives": {
          "$ref": "#/$defs/CacheDirectives",
          "description": "Absent for 'never' (no-store)."
        },
        "anonymous": { "type": "string", "x-seampact-known": ["public", "private"] },
        "vary": { "type": "array", "items": { "type": "string" } },
        "etag": { "type": "boolean" },
        "perCallerKind": { "type": "array", "items": { "$ref": "#/$defs/CallerCacheControl" } },
        "noStore": { "type": "boolean" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "SortKey": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "right": { "$ref": "common.schema.json#/$defs/RightId" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Paging": {
      "type": "object",
      "description": "The paging of a list; 'style' is absent for an unpaged list.",
      "required": ["overLimit", "sortKeys", "origin"],
      "properties": {
        "style": { "$ref": "common.schema.json#/$defs/PagingId" },
        "maxLimit": { "type": "integer", "minimum": 0 },
        "defaultLimit": { "type": "integer", "minimum": 0 },
        "overLimit": { "type": "string", "x-seampact-known": ["reject", "clamp"] },
        "token": { "type": "string", "x-seampact-known": ["opaque", "instant"] },
        "sortKeys": { "type": "array", "items": { "$ref": "#/$defs/SortKey" } },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Csrf": {
      "type": "object",
      "description": "Either the derived CSRF header (header, derivedFrom) or an exemption (exempt, origin).",
      "properties": {
        "header": { "type": "string" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" },
        "exempt": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Degradable": {
      "type": "object",
      "required": ["paths", "origin"],
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" } },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Deprecation": {
      "type": "object",
      "required": ["sunset", "origin"],
      "properties": {
        "sunset": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "successor": { "$ref": "#/$defs/OperationRef" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "OperationMaturity": {
      "type": "object",
      "required": ["level", "source", "origin"],
      "properties": {
        "level": { "$ref": "common.schema.json#/$defs/Maturity" },
        "source": { "type": "string", "x-seampact-known": ["api", "upstream", "stated"] },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "OperationResource": {
      "type": "object",
      "description": "The collection or single it belongs to.",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "idParam": { "type": "string" },
        "idProperty": { "type": "string" }
      }
    },
    "OperationExample": {
      "type": "object",
      "description": "A route example; with 'error', 'value' holds the code's params.",
      "required": ["value"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "request": { "type": "boolean" },
        "error": { "$ref": "common.schema.json#/$defs/ErrorCode" },
        "value": {}
      }
    },
    "Operation": {
      "type": "object",
      "description": "An HTTP operation (ADR 0004 section 7).",
      "required": [
        "kind",
        "id",
        "name",
        "surface",
        "features",
        "method",
        "path",
        "safe",
        "params",
        "unknownQuery",
        "access",
        "callerKinds",
        "principalRequires",
        "scopes",
        "requires",
        "bindings",
        "responses",
        "errors",
        "fieldRights",
        "upstream",
        "maturity",
        "internal",
        "format",
        "tags",
        "examples",
        "docs",
        "extensions",
        "origin"
      ],
      "properties": {
        "kind": { "$ref": "common.schema.json#/$defs/DeclarationKind" },
        "id": { "$ref": "common.schema.json#/$defs/OperationId" },
        "name": { "$ref": "common.schema.json#/$defs/Name" },
        "surface": { "$ref": "common.schema.json#/$defs/SurfaceId" },
        "op": {
          "type": "string",
          "x-seampact-known": ["list", "get", "create", "update", "delete", "batch"]
        },
        "resource": { "$ref": "#/$defs/OperationResource" },
        "features": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Feature" } },
        "method": { "$ref": "#/$defs/HttpMethod" },
        "path": { "type": "string" },
        "safe": { "type": "boolean" },
        "params": { "$ref": "#/$defs/Params" },
        "unknownQuery": { "$ref": "#/$defs/UnknownQuery" },
        "access": { "$ref": "#/$defs/Access" },
        "callerKinds": { "type": "array", "items": { "$ref": "#/$defs/CallerKind" } },
        "principalRequires": {
          "type": "array",
          "items": { "$ref": "#/$defs/PrincipalRequirement" }
        },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/OperationScope" } },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/Requirement" } },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/Binding" } },
        "input": { "$ref": "#/$defs/OperationInput" },
        "responses": { "type": "array", "items": { "$ref": "#/$defs/Response" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/OperationError" } },
        "fieldRights": { "type": "array", "items": { "$ref": "#/$defs/FieldRight" } },
        "idempotency": { "$ref": "#/$defs/Idempotency" },
        "concurrency": { "$ref": "#/$defs/Concurrency" },
        "owner": { "$ref": "#/$defs/Owner" },
        "cache": { "$ref": "#/$defs/Cache" },
        "paging": { "$ref": "#/$defs/Paging" },
        "filteredBy": { "$ref": "common.schema.json#/$defs/RightId" },
        "degradable": { "$ref": "#/$defs/Degradable" },
        "budgetMs": { "type": "integer", "minimum": 0 },
        "deadlineHeader": { "type": "string" },
        "deprecated": { "$ref": "#/$defs/Deprecation" },
        "relays": { "$ref": "#/$defs/OperationRef" },
        "upstream": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/ServiceId" }
        },
        "maturity": { "$ref": "#/$defs/OperationMaturity" },
        "internal": { "type": "boolean" },
        "csrf": { "$ref": "#/$defs/Csrf" },
        "format": { "$ref": "common.schema.json#/$defs/FormatId" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "examples": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/OperationExample" }
        },
        "docs": { "$ref": "common.schema.json#/$defs/Docs" },
        "extensions": { "$ref": "common.schema.json#/$defs/Extensions" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    }
  }
}
