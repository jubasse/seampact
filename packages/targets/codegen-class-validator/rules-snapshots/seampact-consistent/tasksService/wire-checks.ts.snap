export function codePointLength(value: string): number {
  return Array.from(value).length;
}

export function isIntegerMultiple(value: number, integerStep: string): boolean {
  return !Number.isInteger(value) || BigInt(value) % BigInt(integerStep) === 0n;
}

const DATE_TIME =
  /^([0-9]{4})-([0-9]{2})-([0-9]{2})[Tt]([0-9]{2}):([0-9]{2}):([0-9]{2})(?:\.[0-9]{1,9})?(?:[Zz]|[+-]([0-9]{2}):([0-9]{2}))$/;

export function isDateTime(value: string): boolean {
  const match = DATE_TIME.exec(value);

  if (match === null) return false;

  const [
    year = 0,
    month = 0,
    day = 0,
    hour = 0,
    minute = 0,
    second = 0,
    offsetHour = 0,
    offsetMinute = 0,
  ] = match.slice(1).map((part) => Number(part ?? "0"));
  const date = new Date(0);

  date.setUTCFullYear(year, month - 1, day);

  return (
    date.getUTCFullYear() === year &&
    date.getUTCMonth() === month - 1 &&
    date.getUTCDate() === day &&
    hour < 24 &&
    minute < 60 &&
    second < 60 &&
    offsetHour < 24 &&
    offsetMinute < 60
  );
}
