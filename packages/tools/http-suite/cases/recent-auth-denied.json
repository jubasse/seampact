{
  "id": "recent-auth-denied",
  "title": "A recentAuth rule the decider denies answers 401 api.reauthentication_required",
  "checks": ["CHK-016"],
  "profiles": ["default"],
  "script": {
    "decisions": [
      {
        "name": "recentAuth",
        "deny": {
          "code": "api.reauthentication_required"
        }
      }
    ]
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001/tasks/20000000-0000-4000-8000-000000000001/purge",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:purge}}"
        },
        "body": {
          "reauthToken": "expired"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "api.reauthentication_required"
        }
      }
    }
  ]
}
