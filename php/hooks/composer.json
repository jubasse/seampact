{
  "name": "seampact/hooks",
  "description": "The hook interfaces, decision and subject types that seampact-generated PHP boundaries call and your application implements.",
  "type": "library",
  "license": "MIT",
  "keywords": ["hooks", "authorization", "php", "seampact", "api-contract", "openapi", "codegen"],
  "homepage": "https://jubasse.github.io/seampact/concepts/packages/",
  "support": {
    "docs": "https://jubasse.github.io/seampact/",
    "issues": "https://github.com/jubasse/seampact/issues",
    "source": "https://github.com/jubasse/seampact"
  },
  "require": {
    "php": ">=8.3.36 <8.4 || >=8.4.27 <8.5 || >=8.5.12"
  },
  "require-dev": {
    "phpstan/phpstan": "2.2.16",
    "phpunit/phpunit": "11.5.56"
  },
  "autoload": {
    "psr-4": {
      "Seampact\\Hooks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Seampact\\Hooks\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.36"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
