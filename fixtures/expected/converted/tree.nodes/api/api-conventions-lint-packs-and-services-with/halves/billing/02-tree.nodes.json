  "api": {
    "id": "billing",
    "name": {
      "segments": [
        "billing"
      ],
      "role": "schema"
    },
    "version": {
      "kind": "path",
      "number": 1
    },
    "kind": "service",
    "pathVersion": {
      "value": "prefix",
      "origin": {
        "layer": "api",
        "pointer": "/api/version"
      }
    },
    "role": "gateway",
    "maturity": "experimental",
    "caller": {
      "identity": "service",
      "right": "callerService"
    },
    "compat": {
      "policy": "none"
    },
    "surfaces": {
      "app": {
        "name": {
          "segments": [
            "app"
          ],
          "role": "schema"
        },
        "prefix": "/v1",
        "pathVersion": "prefix",
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/app"
        }
      },
      "ops": {
        "name": {
          "segments": [
            "ops"
          ],
          "role": "schema"
        },
        "prefix": "/v1/ops",
        "pathVersion": "prefix",
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/ops"
        }
      }
    },
    "documents": {
      "internalOnly": {
        "surfaces": [
          "ops"
        ],
        "internal": "include"
      },
      "everything": {
        "surfaces": [
          "app",
          "ops"
        ],
        "internal": "include"
      }
    },
    "docs": {
      "summary": "Invoices.",
      "description": "Invoices sent to customers."
    },
    "extensions": {},
    "origin": {
      "layer": "api",
      "pointer": "/api"
    }
