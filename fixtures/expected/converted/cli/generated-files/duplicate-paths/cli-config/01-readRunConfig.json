{
  "function": "readRunConfig",
  "args": [
    "<root>/seampact.config.yaml",
    "seampact.config.yaml",
    null
  ],
  "result": {
    "status": "read",
    "run": {
      "kind": "app",
      "config": {
        "file": "<root>/seampact.config.yaml",
        "outDir": "<root>/__generated__",
        "sources": {
          "a": {
            "kind": "path",
            "directory": "<root>/a"
          }
        },
        "entries": [
          {
            "entry": {
              "id": "server",
              "use": "probe-server",
              "api": "tasks",
              "options": {
                "files": [
                  {
                    "path": "a.ts",
                    "contents": "export const a = 1;\n"
                  },
                  {
                    "path": "a.ts",
                    "contents": "export const a = 2;\n"
                  }
                ]
              }
            },
            "root": "<root>/__generated__/server"
          }
        ]
      }
    }
  }
}
