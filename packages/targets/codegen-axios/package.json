{
  "name": "@seampact/codegen-axios",
  "description": "Seampact target that runs the typed fetch client over your own axios instance, so the React, Vue and Angular targets use axios.",
  "license": "MIT",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/targets/codegen-axios"
  },
  "homepage": "https://jubasse.github.io/seampact/frontend/axios-client/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "keywords": [
    "axios",
    "client",
    "typescript",
    "seampact",
    "api-contract",
    "openapi",
    "codegen"
  ],
  "type": "module",
  "files": [
    "dist",
    "runtime"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/codegen-fetch": "workspace:*",
    "@seampact/spec": "workspace:*",
    "axios": ">=1.7 <2"
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/codegen-fetch": "workspace:*",
    "@seampact/spec": "workspace:*",
    "axios": "1.21.0",
    "msw": "2.15.0"
  }
}
