{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "seampact shared definitions",
  "description": "Definitions the other authoring schemas reference.",
  "$defs": {
    "path": {
      "title": "path",
      "description": "A path relative to the file that holds it, starting with './' or '../', with forward slashes (ADR 0002 section 1).",
      "type": "string",
      "pattern": "^\\.\\.?/[^\\\\#\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\u2028\\u2029]+$"
    },
    "pointerPath": {
      "title": "path",
      "description": "A relative path, optionally followed by '#' and a JSON Pointer into that file (ADR 0002 section 2).",
      "type": "string",
      "pattern": "^\\.\\.?/[^\\\\#\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\u2028\\u2029]+(?:#/[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\u2028\\u2029]*)?$"
    },
    "include": {
      "if": {
        "type": "string"
      },
      "then": {
        "$ref": "#/$defs/pointerPath"
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointerPath"
          },
          "minItems": 1
        },
        "else": {
          "title": "alternatives",
          "description": "a string or a list",
          "type": "array"
        }
      },
      "$comment": "ADR 0002 section 2",
      "description": "Merges the mapping of each file in place of this key, in list order (ADR 0002 section 2)."
    },
    "file": {
      "type": "object",
      "description": "Replaces this value with a file's content (ADR 0002 section 2).",
      "properties": {
        "$file": {
          "$ref": "#/$defs/path",
          "$comment": "ADR 0002 section 2"
        },
        "$include": {
          "$ref": "#/$defs/include"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "$include": true
        },
        "required": [
          "$include"
        ]
      },
      "else": {
        "properties": {
          "$file": true
        },
        "required": [
          "$file"
        ]
      }
    },
    "summary": {
      "type": "string",
      "$comment": "ADR 0002 section 12",
      "description": "Docs: one line."
    },
    "description": {
      "if": {
        "type": "string"
      },
      "then": {
        "type": "string"
      },
      "else": {
        "if": {
          "type": "object"
        },
        "then": {
          "$ref": "#/$defs/file"
        },
        "else": {
          "title": "alternatives",
          "description": "a string or a mapping",
          "type": "object"
        }
      },
      "$comment": "ADR 0002 section 12",
      "description": "Docs: a string, or { $file: <path> } to a .md or .txt file."
    },
    "reason": {
      "title": "reason",
      "description": "A reason: a non-empty string. Required on every safety exception, and only there (ADR 0002 section 4, A40).",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "duration": {
      "title": "duration",
      "description": "An integer followed by ms, s, m, h or d: 300ms, 15m, 24h (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^[0-9]+(?:ms|s|m|h|d)$"
    },
    "size": {
      "title": "size",
      "description": "An integer followed by B, KiB or MiB: 1MiB (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^[0-9]+(?:B|KiB|MiB)$"
    },
    "date": {
      "title": "date",
      "description": "A quoted ISO 8601 date: '2027-06-30' (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "name": {
      "title": "name",
      "description": "A lowercase letter, then letters, digits or '_': tasks, viewer_or_device (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9_]*$"
    },
    "schemaName": {
      "title": "schema name",
      "description": "An uppercase letter, then letters or digits: Task, TaskId (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "scalarName": {
      "title": "scalar name",
      "description": "A named format: money, iri-reference (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "rightName": {
      "title": "right name",
      "description": "Any non-empty string without control characters and without leading or trailing space (ADR 0002 section 4); not __proto__, constructor or prototype.",
      "type": "string",
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\u2028\\u2029](?:[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\u2028\\u2029]*[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\u2028\\u2029])?$",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "errorCode": {
      "title": "error code",
      "description": "A letter or digit, then letters, digits, '.', '_' or '-': api.forbidden, E1042 (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "headerName": {
      "title": "header name",
      "description": "An HTTP header name.",
      "type": "string",
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
    },
    "ruleId": {
      "title": "rule id",
      "description": "A lint rule id: seampact/<rule> or <plugin>/<rule>.",
      "type": "string",
      "pattern": "^[^\\s/]+(?:/[^\\s/]+)+$"
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/errorCode"
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "method": {
      "enum": [
        "get",
        "post",
        "put",
        "patch",
        "delete"
      ]
    },
    "maturityLevel": {
      "enum": [
        "experimental",
        "provisional",
        "stable"
      ]
    },
    "template": {
      "title": "template",
      "description": "A template: a JSON value whose '$<slot>' strings the boundary fills (ADR 0002 section 13)."
    },
    "unknownKeysPolicy": {
      "title": "unknown keys policy",
      "description": "refuse (the default), { ignore: \"<reason>\" } or { keep: \"<reason>\" } (ADR 0003 section 4).",
      "if": {
        "type": "string"
      },
      "then": {
        "title": "reasoned policy",
        "enum": [
          "refuse"
        ]
      },
      "else": {
        "if": {
          "type": "object"
        },
        "then": {
          "type": "object",
          "title": "unknown keys exception",
          "properties": {
            "ignore": {
              "$ref": "#/$defs/reason",
              "$comment": "ADR 0003 section 4"
            },
            "keep": {
              "$ref": "#/$defs/reason",
              "$comment": "ADR 0003 section 4"
            },
            "$include": {
              "$ref": "#/$defs/include"
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "ignore": true
            },
            "required": [
              "ignore"
            ]
          },
          "then": {
            "properties": {
              "keep": {
                "title": "conflict",
                "description": "Write 'ignore' or 'keep', not both.",
                "not": {}
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "$include": true
              },
              "required": [
                "$include"
              ]
            },
            "else": {
              "properties": {
                "keep": true
              },
              "required": [
                "keep"
              ],
              "title": "unknown keys exception"
            }
          }
        },
        "else": {
          "title": "alternatives",
          "description": "a string or a mapping",
          "type": "object"
        }
      }
    },
    "unknownKeysException": {
      "title": "unknown keys policy",
      "description": "{ ignore: \"<reason>\" } or { keep: \"<reason>\" } (ADR 0002 section 9).",
      "if": {
        "type": "string"
      },
      "then": {
        "title": "reasoned policy",
        "not": {}
      },
      "else": {
        "if": {
          "type": "object"
        },
        "then": {
          "type": "object",
          "title": "unknown keys exception",
          "properties": {
            "ignore": {
              "$ref": "#/$defs/reason",
              "$comment": "ADR 0002 section 9"
            },
            "keep": {
              "$ref": "#/$defs/reason",
              "$comment": "ADR 0002 section 9"
            },
            "$include": {
              "$ref": "#/$defs/include"
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "ignore": true
            },
            "required": [
              "ignore"
            ]
          },
          "then": {
            "properties": {
              "keep": {
                "title": "conflict",
                "description": "Write 'ignore' or 'keep', not both.",
                "not": {}
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "$include": true
              },
              "required": [
                "$include"
              ]
            },
            "else": {
              "properties": {
                "keep": true
              },
              "required": [
                "keep"
              ],
              "title": "unknown keys exception"
            }
          }
        },
        "else": {
          "title": "alternatives",
          "description": "a string or a mapping",
          "type": "object"
        }
      }
    },
    "unknownQueryPolicy": {
      "title": "unknown query policy",
      "description": "refuse, or { ignore: \"<reason>\" } (ADR 0002 section 7).",
      "if": {
        "type": "string"
      },
      "then": {
        "title": "reasoned policy",
        "enum": [
          "refuse"
        ]
      },
      "else": {
        "if": {
          "type": "object"
        },
        "then": {
          "type": "object",
          "title": "query exception",
          "properties": {
            "ignore": {
              "$ref": "#/$defs/reason",
              "$comment": "ADR 0002 section 7"
            },
            "$include": {
              "$ref": "#/$defs/include"
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "$include": true
            },
            "required": [
              "$include"
            ]
          },
          "else": {
            "properties": {
              "ignore": true
            },
            "required": [
              "ignore"
            ],
            "title": "query exception"
          }
        },
        "else": {
          "title": "alternatives",
          "description": "a string or a mapping",
          "type": "object"
        }
      }
    },
    "lintAllow": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "object",
          "properties": {
            "$include": {
              "$ref": "#/$defs/include"
            }
          },
          "propertyNames": {
            "description": "a lint rule id (ADR 0002 section 12)",
            "pattern": "^(?:[^\\s/]+(?:/[^\\s/]+)+|\\$include)$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/reason"
          },
          "$comment": "ADR 0002 section 12",
          "description": "Silences one lint rule here, with a reason."
        },
        "$include": {
          "$ref": "#/$defs/include"
        }
      },
      "additionalProperties": false
    },
    "lintRules": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "object",
          "properties": {
            "$include": {
              "$ref": "#/$defs/include"
            }
          },
          "propertyNames": {
            "description": "a lint rule id (ADR 0002 section 12)",
            "pattern": "^(?:[^\\s/]+(?:/[^\\s/]+)+|\\$include)$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "enum": [
              "disabled",
              "warning",
              "error"
            ]
          },
          "$comment": "ADR 0002 section 12",
          "description": "Each rule's severity: disabled, warning or error."
        },
        "$include": {
          "$ref": "#/$defs/include"
        }
      },
      "additionalProperties": false
    },
    "subjectSource": {
      "title": "value source",
      "description": "A requirement subject: path.<param>, query.<param>, header.<Name>, principal.<field>, scope.<scope> (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:path\\.[^.\\s]+|query\\.[^.\\s]+|header\\.[!#$%&'*+.^_`|~0-9A-Za-z-]+|principal\\.[^.\\s]+(?:\\.[^.\\s]+)*|scope\\.[a-z][A-Za-z0-9_]*)$"
    },
    "scopeSource": {
      "title": "value source",
      "description": "A scope id: path.<param>, query.<param>, header.<Name>, host, subdomain, principal.<field>, resolver (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:path\\.[^.\\s]+|query\\.[^.\\s]+|header\\.[!#$%&'*+.^_`|~0-9A-Za-z-]+|host|subdomain|principal\\.[^.\\s]+(?:\\.[^.\\s]+)*|resolver)$"
    },
    "bindingKey": {
      "title": "value source",
      "description": "A binding key: path.<param>, query.<param>, body.<field> (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:path\\.[^.\\s]+|query\\.[^.\\s]+|body\\.[^.\\s]+(?:\\.[^.\\s]+)*)$"
    },
    "bindingValue": {
      "title": "value source",
      "description": "A binding value: principal.<field> (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:principal\\.[^.\\s]+(?:\\.[^.\\s]+)*)$"
    },
    "concurrencySource": {
      "title": "value source",
      "description": "A version source: body.<field>, query.<param>, header.<Name> (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:body\\.[^.\\s]+(?:\\.[^.\\s]+)*|query\\.[^.\\s]+|header\\.[!#$%&'*+.^_`|~0-9A-Za-z-]+)$"
    },
    "bucketKeySource": {
      "title": "value source",
      "description": "A bucket key: address, address/<bits>, principal.<field>, body.<field> (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:address(?:/[0-9]{1,3})?|principal\\.[^.\\s]+(?:\\.[^.\\s]+)*|body\\.[^.\\s]+(?:\\.[^.\\s]+)*)$"
    },
    "signatureKeySource": {
      "title": "value source",
      "description": "A signature key: path.<param>, query.<param>, header.<Name> (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:path\\.[^.\\s]+|query\\.[^.\\s]+|header\\.[!#$%&'*+.^_`|~0-9A-Za-z-]+)$"
    },
    "discriminatorSource": {
      "title": "value source",
      "description": "A union tag source: header.<Name> (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:header\\.[!#$%&'*+.^_`|~0-9A-Za-z-]+)$"
    },
    "principalSource": {
      "title": "value source",
      "description": "A principal field: principal.<field> (ADR 0002 section 4).",
      "type": "string",
      "pattern": "^(?:principal\\.[^.\\s]+(?:\\.[^.\\s]+)*)$"
    }
  }
}
