{
  "id": "scope-non-member-denied",
  "title": "A channel the scope resolver denies answers its declared 404",
  "checks": ["CHK-093"],
  "profiles": ["default"],
  "script": {
    "scopes": {
      "channel": {
        "deny": {
          "code": "api.not_found"
        }
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001/tasks",
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "code": "api.not_found"
        }
      }
    }
  ]
}
