{
  "rights": {
    "roles": {
      "id": "roles",
      "params": "RolesParams",
      "subject": {
        "kind": "scope",
        "scope": "account"
      },
      "errors": [
        "api.forbidden"
      ],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "shared",
        "pointer": "/rights/roles"
      }
    }
  },
  "rules": {
    "throttle": {
      "id": "throttle",
      "takesBucket": true,
      "errors": [
        "api.rate_limited"
      ],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "shared",
        "pointer": "/rules/throttle"
      }
    }
  },
  "scopes": {
    "account": {
      "id": "account",
      "idSchema": {
        "kind": "scalar",
        "type": "string",
        "format": "uuid",
        "refinements": {}
      },
      "errors": [
        "api.not_found"
      ],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "shared",
        "pointer": "/scopes/account"
      }
    }
  },
  "buckets": {
    "write": {
      "id": "write",
      "key": [
        {
          "in": "principal",
          "name": "userId"
        }
      ],
      "limit": 60,
      "windowMs": 60000,
      "origin": {
        "layer": "shared",
        "pointer": "/buckets/write"
      }
    }
  },
