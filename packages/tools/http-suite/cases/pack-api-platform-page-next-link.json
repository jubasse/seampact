{
  "id": "pack-api-platform-page-next-link",
  "title": "A page is fetched with the api-platform request names, its view links carry the page and limit names and base, and the next link is followed (the member count is not asserted: the sample app answers one item whatever itemsPerPage says)",
  "checks": ["CHK-031", "CHK-107"],
  "profiles": ["pack:api-platform"],
  "steps": [
    {
      "title": "first page",
      "request": {
        "method": "GET",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001/tasks",
        "query": {
          "itemsPerPage": 2,
          "page": 1
        },
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "capture": {
        "nextPage": {
          "body": "/view/next"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "@type": "Collection",
          "view": {
            "@id": "?itemsPerPage=2&page=1",
            "first": "?itemsPerPage=2&page=1",
            "next": "?itemsPerPage=2&page=2"
          }
        }
      }
    },
    {
      "title": "the next link",
      "request": {
        "method": "GET",
        "path": "{{nextPage}}",
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "view": {
            "@id": "?itemsPerPage=2&page=2",
            "first": "?itemsPerPage=2&page=1"
          }
        }
      }
    }
  ]
}
