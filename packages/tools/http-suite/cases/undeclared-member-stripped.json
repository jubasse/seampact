{
  "id": "undeclared-member-stripped",
  "title": "A member the handler returns but the schema does not declare is stripped",
  "checks": ["CHK-049", "CHK-064"],
  "profiles": ["default"],
  "script": {
    "answers": {
      "tasks.getChannel": {
        "status": 200,
        "body": {
          "channelId": "10000000-0000-4000-8000-000000000001",
          "name": "General",
          "internalNote": "not for the wire"
        }
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001",
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "channelId": "10000000-0000-4000-8000-000000000001",
          "name": "General"
        },
        "absent": ["/internalNote"]
      }
    }
  ]
}
