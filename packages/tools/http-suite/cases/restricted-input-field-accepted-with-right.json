{
  "id": "restricted-input-field-accepted-with-right",
  "title": "A restricted input field sent with its right reaches the handler",
  "checks": ["CHK-092"],
  "profiles": ["default", "hand-written"],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001/tasks",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:create}}"
        },
        "body": {
          "title": "Estimated",
          "effort": 3
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "title": "Estimated"
        }
      }
    }
  ]
}
