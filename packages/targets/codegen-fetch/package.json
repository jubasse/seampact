{
  "name": "@seampact/codegen-fetch",
  "description": "Seampact target that generates a typed fetch client with one method per operation, returning success and error responses as typed results.",
  "license": "MIT",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/targets/codegen-fetch"
  },
  "homepage": "https://jubasse.github.io/seampact/frontend/react/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "keywords": [
    "fetch",
    "client",
    "typescript",
    "seampact",
    "api-contract",
    "openapi",
    "codegen"
  ],
  "type": "module",
  "files": [
    "dist",
    "runtime"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  }
}
