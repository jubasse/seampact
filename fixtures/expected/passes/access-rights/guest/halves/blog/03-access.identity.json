        "layer": "api",
        "pointer": "/schemes/bearer"
      }
    }
  },
  "identities": {
    "reader": {
      "id": "reader",
      "kind": "credential",
      "schemes": {
        "read": [
          "bearer"
        ],
        "write": [
          "bearer"
        ],
        "optionalRead": []
      },
      "principal": {
        "kind": "schema",
        "schema": "Reader"
      },
      "errors": [],
      "headers": [],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "api",
        "pointer": "/identities/reader"
      }
    }
  },
  "operations": {
    "getArticle": {
      "access": {
        "kind": "public",
        "reason": "Published articles are public.",
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/app/routes/articles/access"
        }
      },
      "callerKinds": [
        "anonymous"
      ],
      "principalRequires": [],
      "bindings": []
