{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The naming vectors (ADR 0007 section 6)",
  "description": "vectors.json is an array of vectors sorted by id. A harness feeds each vector's INPUT fields to its implementation and compares the EXPECTED fields; `id` and `category` are labels and are not asserted. Inputs: `role`, and either `written` with `source` (and optionally `codeName`, `position`) or, for a derived name, `owner` (and `status` for the `response` role). Expected, normative: `segments` and `expected` (the identifier per language, `typescript` null when the language has no identifier for the role), or `error` instead of both; `canonicalId` (the escaped TypeScript identifier, for a derived name) and `operationId` (camel and snake strings, pure casing) when present.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/vector"
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "role"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z-]+/[A-Za-z0-9-]+$",
          "description": "Stable unique key, `<category>/<slug>`; the file is sorted by it."
        },
        "category": {
          "enum": [
            "splitting",
            "digits",
            "enum-fallback",
            "right",
            "reserved",
            "php-case",
            "derived"
          ]
        },
        "role": {
          "enum": [
            "schema",
            "input",
            "output",
            "query",
            "headers",
            "path",
            "response",
            "params",
            "error",
            "errors",
            "property",
            "item",
            "value",
            "variant",
            "endpoints",
            "operation",
            "member",
            "enumMember"
          ]
        },
        "source": {
          "enum": ["name", "enumValue", "right"],
          "description": "What the written name is: an enum value without segments becomes value<position>; a right or a name without segments is an error."
        },
        "written": {
          "type": "string",
          "description": "The name as written in a contract."
        },
        "codeName": {
          "type": "string",
          "description": "Replaces the segments split from `written`."
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based position of an enum value in its enum."
        },
        "owner": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "description": "For a derived name, the segments of the owner (the Name's segments)."
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "description": "The integer status of a `response` role (ADR 0004: the IR's status is a number); present exactly for that role."
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          }
        },
        "error": {
          "const": "no-segment",
          "description": "The name yields no segment: a compile error naming it."
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["typescript", "kotlin", "java", "php"],
          "properties": {
            "typescript": {
              "type": ["string", "null"],
              "description": "null when the language has no identifier for the role (an enum member)."
            },
            "kotlin": {
              "type": "string",
              "minLength": 1
            },
            "java": {
              "type": "string",
              "minLength": 1
            },
            "php": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "canonicalId": {
          "type": "string",
          "minLength": 1,
          "description": "The canonical id of ADR 0004 section 9 (the TypeScript form), for a derived name."
        },
        "operationId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["camel", "snake"],
          "properties": {
            "camel": {
              "type": "string",
              "minLength": 1
            },
            "snake": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "The operation id under conventions.operationIds.case, for the operation role."
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["written", "source"],
              "not": {
                "anyOf": [
                  {
                    "required": ["owner"]
                  },
                  {
                    "required": ["status"]
                  }
                ]
              }
            },
            {
              "required": ["owner"],
              "not": {
                "anyOf": [
                  {
                    "required": ["written"]
                  },
                  {
                    "required": ["source"]
                  },
                  {
                    "required": ["codeName"]
                  },
                  {
                    "required": ["position"]
                  }
                ]
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["segments", "expected"],
              "not": {
                "required": ["error"]
              }
            },
            {
              "required": ["error"],
              "not": {
                "anyOf": [
                  {
                    "required": ["segments"]
                  },
                  {
                    "required": ["expected"]
                  }
                ]
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "response"
              }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["owner", "status"]
          },
          "else": {
            "not": {
              "required": ["status"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "enumMember"
              }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "expected": {
                "type": "object",
                "properties": {
                  "typescript": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "expected": {
                "type": "object",
                "properties": {
                  "typescript": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ],
      "title": "A naming vector (ADR 0007 section 6)"
    }
  }
}
