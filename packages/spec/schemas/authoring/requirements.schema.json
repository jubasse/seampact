{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "seampact requirements catalogue",
  "description": "Named requirement items (ADR 0002 section 9). A name-keyed catalogue file.",
  "type": "object",
  "properties": {
    "$include": {
      "$ref": "common.schema.json#/$defs/include"
    }
  },
  "propertyNames": {
    "description": "a requirement name (ADR 0002 section 4)",
    "pattern": "^(?:[a-z][A-Za-z0-9_]*|\\$include)$"
  },
  "additionalProperties": {
    "$ref": "node.schema.json#/$defs/requirement"
  },
  "$defs": {}
}
