                queryCache.invalidateQueries({ key: entry.key, exact: true }),
              ),
          );
          await onSuccess?.(data, request, context);
        },
      });
    },
  };
}

/** What `createTasksQueries` returns. */
export type TasksQueries = ReturnType<typeof createTasksQueries>;
