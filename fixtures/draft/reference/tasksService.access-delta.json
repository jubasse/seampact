{
  "access.identity": {
    "schemes": {
      "sessionCookie": {
        "id": "sessionCookie",
        "kind": "cookie",
        "name": "__Host-session",
        "csrf": "csrfToken",
        "origin": {
          "layer": "shared",
          "pointer": "/schemes/sessionCookie"
        }
      },
      "csrfToken": {
        "id": "csrfToken",
        "kind": "header",
        "name": "X-Csrf-Token",
        "origin": {
          "layer": "shared",
          "pointer": "/schemes/csrfToken"
        }
      },
      "bearer": {
        "id": "bearer",
        "kind": "bearer",
        "origin": {
          "layer": "shared",
          "pointer": "/schemes/bearer"
        }
      },
      "internalToken": {
        "id": "internalToken",
        "kind": "bearer",
        "bearer": {
          "format": "jwt"
        },
        "origin": {
          "layer": "shared",
          "pointer": "/schemes/internalToken"
        }
      },
      "stripeSignature": {
        "id": "stripeSignature",
        "kind": "signature",
        "name": "Stripe-Signature",
        "signature": {
          "verify": "template",
          "format": "t={ts},v1={sig}",
          "algorithm": "hmac-sha256",
          "payload": "{ts}.{rawBody}",
          "encoding": "hex",
          "toleranceMs": 300000,
          "key": {
            "kind": "value",
            "value": "stripe"
          }
        },
        "origin": {
          "layer": "shared",
          "pointer": "/schemes/stripeSignature"
        }
      }
    },
    "headers": {
      "deadline": {
        "id": "deadline",
        "semantic": "deadline",
        "name": "X-Deadline",
        "in": "request",
        "origin": {
          "layer": "shared",
          "pointer": "/headers/deadline"
        }
      },
      "trace": {
        "id": "trace",
        "semantic": "traceContext",
        "name": "traceparent",
        "in": "request",
        "origin": {
          "layer": "shared",
          "pointer": "/headers/trace"
        }
      },
      "actorSurface": {
        "id": "actorSurface",
        "semantic": "actorSurface",
        "name": "X-Actor-Surface",
        "in": "request",
        "origin": {
          "layer": "shared",
          "pointer": "/headers/actorSurface"
        }
      }
    },
    "identities": {
      "user": {
        "id": "user",
        "kind": "credential",
        "schemes": {
          "read": ["bearer", "sessionCookie"],
          "write": ["bearer", "sessionCookie"],
          "optionalRead": []
        },
        "principal": {
          "kind": "schema",
          "schema": "UserPrincipal"
        },
        "errors": [],
        "headers": [],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/identities/user"
        }
      },
      "service": {
        "id": "service",
        "kind": "credential",
        "schemes": {
          "read": ["internalToken"],
          "write": ["internalToken"],
          "optionalRead": []
        },
        "principal": {
          "kind": "schema",
          "schema": "ServicePrincipal"
        },
        "headers": [
          {
            "header": "deadline",
            "for": "all",
            "required": true,
            "origin": {
              "layer": "shared",
              "pointer": "/identities/service/headers/deadline"
            }
          },
          {
            "header": "trace",
            "for": "all",
            "required": false,
            "origin": {
              "layer": "shared",
              "pointer": "/identities/service/headers/trace"
            }
          },
          {
            "header": "actorSurface",
            "for": "writes",
            "required": true,
            "schema": {
              "kind": "enum",
              "enum": "Surface"
            },
            "origin": {
              "layer": "shared",
              "pointer": "/identities/service/headers/actorSurface"
            }
          }
        ],
        "errors": [],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/identities/service"
        }
      },
      "stripe": {
        "id": "stripe",
        "kind": "signed",
        "signed": "stripeSignature",
        "principal": {
          "kind": "schema",
          "schema": "WebhookCaller"
        },
        "errors": [],
        "headers": [],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/identities/stripe"
        }
      }
    },
    "operations": {
      "getTask": {
        "access": {
          "kind": "identity",
          "identity": "service",
          "schemes": ["internalToken"],
          "origin": {
            "layer": "api",
            "pointer": "/api/caller/identity"
          }
        },
        "callerKinds": ["identified"],
        "principalRequires": [],
        "bindings": []
      }
    }
  },
  "access.rights": {
    "rights": {
      "roles": {
        "id": "roles",
        "params": "RolesParams",
        "subject": {
          "kind": "scope",
          "scope": "channel"
        },
        "errors": [],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/rights/roles"
        }
      },
      "tasks.read": {
        "id": "tasks.read",
        "subject": {
          "kind": "scope",
          "scope": "channel"
        },
        "errors": [],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/rights/tasks.read"
        }
      },
      "tasks.update": {
        "id": "tasks.update",
        "subject": {
          "kind": "resource",
          "type": {
            "segments": ["task"],
            "role": "schema"
          },
          "idSchema": {
            "kind": "scalar",
            "type": "string",
            "format": "uuid",
            "refinements": {}
          }
        },
        "errors": ["api.forbidden", "api.not_found"],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/rights/tasks.update"
        }
      },
      "tasks.seeEffort": {
        "id": "tasks.seeEffort",
        "subject": {
          "kind": "resource",
          "type": {
            "segments": ["task"],
            "role": "schema"
          },
          "idSchema": {
            "kind": "scalar",
            "type": "string",
            "format": "uuid",
            "refinements": {}
          }
        },
        "errors": [],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/rights/tasks.seeEffort"
        }
      },
      "callerService": {
        "id": "callerService",
        "params": "CallerServiceParams",
        "subject": {
          "kind": "none"
        },
        "errors": [],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/rights/callerService"
        }
      }
    },
    "rules": {
      "throttle": {
        "id": "throttle",
        "takesBucket": true,
        "errors": ["api.rate_limited"],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/rules/throttle"
        }
      }
    },
    "scopes": {
      "channel": {
        "id": "channel",
        "idSchema": {
          "kind": "scalar",
          "type": "string",
          "format": "uuid",
          "refinements": {}
        },
        "errors": ["api.not_found"],
        "docs": {},
        "extensions": {},
        "origin": {
          "layer": "shared",
          "pointer": "/scopes/channel"
        }
      }
    },
    "buckets": {
      "write": {
        "id": "write",
        "key": [
          {
            "in": "principal",
            "name": "userId"
          }
        ],
        "limit": 60,
        "windowMs": 60000,
        "origin": {
          "layer": "shared",
          "pointer": "/buckets/write"
        }
      }
    },
    "operations": {
      "getTask": {
        "scopes": [],
        "requires": [
          {
            "kind": "right",
            "right": "callerService",
            "params": {
              "allowed": ["catalog"]
            },
            "origin": {
              "layer": "api",
              "pointer": "/surfaces/internal/requires/0"
            }
          }
        ],
        "fieldRights": []
      }
    }
  }
}
