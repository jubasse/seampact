{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seampact.dev/schemas/validator-agreement/table.schema.json",
  "title": "Validator agreement table",
  "description": "Payloads with the verdict every validator target must give, per schema and direction (ADR 0015, FR-15).",
  "type": "object",
  "required": ["rows"],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["id", "schema", "direction", "expected", "rule"],
      "additionalProperties": false,
      "oneOf": [
        { "properties": { "payload": true }, "required": ["payload"] },
        { "properties": { "payloadText": true }, "required": ["payloadText"] }
      ],
      "properties": {
        "id": {
          "description": "The schema name, a dot and a slug; unique in the table.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9-]*$"
        },
        "case": {
          "description": "The ADR 0015 or ADR 0003 case the row belongs to, when it belongs to one.",
          "enum": [
            "root-union-input",
            "per-subtree-unknown-keys",
            "optional-not-nullable-null",
            "variation-selector-length",
            "empty-object-for-list",
            "empty-array-for-object",
            "integer-as-float",
            "optional-nullable-empty-object",
            "nine-digit-fraction",
            "unknown-keys-ignore",
            "unknown-keys-keep",
            "opaque-value",
            "format-boundaries",
            "portable-patterns",
            "recursive-schema"
          ]
        },
        "schema": {
          "description": "A named schema of the contract.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "direction": { "enum": ["input", "output"] },
        "payload": { "description": "The JSON value, when parsing it loses nothing." },
        "payloadText": {
          "description": "The exact JSON text, for a spelling a parser would normalise (1.0, 1e2).",
          "type": "string"
        },
        "expected": { "enum": ["accept", "reject"] },
        "rule": {
          "description": "The ADR line that gives the verdict: adr0003/<section>/<slug>.",
          "type": "string",
          "pattern": "^adr0003/[a-z0-9]+/[A-Za-z0-9-]+$"
        },
        "received": {
          "description": "What the handler receives, for an accepted input that drops or keeps unknown keys."
        }
      }
    }
  }
}
