{
  "function": "planAppDocuments",
  "args": [
    {
      "file": "<root>/seampact.config.yaml",
      "outDir": "<root>/__generated__",
      "sources": {
        "a": {
          "kind": "path",
          "directory": "<root>/a"
        }
      },
      "entries": [
        {
          "entry": {
            "id": "server",
            "use": "probe-server",
            "api": "tasks",
            "options": {
              "refusals": [
                {
                  "code": "access.optional.unsupported",
                  "message": "Optional authentication is not generated yet.",
                  "fix": "Ask the user first: make the access required or public.",
                  "member": "/operations/0/access",
                  "docs": "https://jubasse.github.io/seampact/troubleshooting/generate/#node-servers"
                },
                {
                  "code": "options.unknown",
                  "message": "The option 'x' is unknown.",
                  "fix": "Remove 'x'."
                }
              ]
            }
          },
          "root": "<root>/__generated__/server"
        }
      ]
    },
    {
      "server": "server"
    },
    [
      {
        "source": "a",
        "api": "tasks",
        "documents": [
          "full",
          "public"
        ]
      }
    ]
  ],
  "result": {
    "status": "planned",
    "documents": [
      {
        "source": "a",
        "api": "tasks",
        "document": "full",
        "file": "<root>/openapi/tasks.full.yaml",
        "options": {}
      },
      {
        "source": "a",
        "api": "tasks",
        "document": "public",
        "file": "<root>/openapi/tasks.public.yaml",
        "options": {}
      }
    ]
  }
}
