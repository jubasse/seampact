{
  "name": "@seampact/codegen-core",
  "description": "The API the seampact code generators are written against, for writing your own generator.",
  "license": "MIT",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/core/codegen-core"
  },
  "homepage": "https://jubasse.github.io/seampact/concepts/packages/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "keywords": [
    "generator",
    "plugin-api",
    "seampact",
    "api-contract",
    "openapi",
    "codegen"
  ],
  "type": "module",
  "files": [
    "dist",
    "front-runtime",
    "native-docs-runtime"
  ],
  "main": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node-server": {
        "types": "./dist/node-server/index.d.ts",
        "default": "./dist/node-server/index.js"
      },
      "./validators": {
        "types": "./dist/validators/index.d.ts",
        "default": "./dist/validators/index.js"
      }
    }
  },
  "seampact": {
    "role": "core"
  },
  "dependencies": {
    "@seampact/spec": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node-server": "./src/node-server/index.ts",
    "./validators": "./src/validators/index.ts",
    "./node-server/test-support": "./src/node-server/test-support.ts"
  }
}
