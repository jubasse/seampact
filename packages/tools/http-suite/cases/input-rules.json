{
  "id": "input-rules",
  "title": "App input rules run after the contract and the claim, answer the schema-invalid role and release the claim",
  "checks": [
    {
      "id": "CHK-190",
      "targets": ["nestjs", "fastify", "express", "adonis", "hono", "nextjs", "laravel", "symfony"]
    }
  ],
  "apis": ["inputRules"],
  "profiles": ["default"],
  "steps": [
    {
      "title": "no credentials stops before the rule",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "idempotency-key": "{{uuid:anon}}"
        },
        "body": {
          "start": "2026-01-02",
          "end": "2026-01-01"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "api.unauthenticated"
        }
      }
    },
    {
      "script": {
        "decisions": [
          {
            "name": "roles",
            "purpose": "route",
            "deny": {
              "code": "api.forbidden"
            }
          }
        ]
      }
    },
    {
      "title": "a denied right stops before the rule",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:denied}}"
        },
        "body": {
          "start": "2026-01-02",
          "end": "2026-01-01"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "api.forbidden"
        }
      }
    },
    {
      "script": {}
    },
    {
      "title": "a rule refusal names the app rule and the member",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:fix}}"
        },
        "body": {
          "start": "2026-01-02",
          "end": "2026-01-01"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "api.schema_invalid",
          "issues": [
            {
              "pointer": "/end",
              "rule": "app.endAfterStart"
            }
          ]
        }
      }
    },
    {
      "title": "the corrected retry with the same key is checked again and passes",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:fix}}"
        },
        "body": {
          "start": "2026-01-01",
          "end": "2026-01-02"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "title": "a retry after success replays the 2xx",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:fix}}"
        },
        "body": {
          "start": "2026-01-01",
          "end": "2026-01-02"
        }
      },
      "expect": {
        "status": 201,
        "headers": {
          "idempotency-replayed": {
            "equals": "true"
          }
        }
      }
    },
    {
      "title": "a cross-member rule with no path points at the whole body, or at its member on a library without object rules",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:window}}"
        },
        "body": {
          "start": "2026-01-01",
          "end": "2026-06-01"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "api.schema_invalid",
          "issues": [
            {
              "pointer": "{{inputRulesCrossMemberPointer}}",
              "rule": "app.windowTooLong"
            }
          ]
        }
      }
    },
    {
      "title": "a rule without a usable name renders app.invalid",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:unnamed}}"
        },
        "body": {
          "start": "2026-01-01",
          "end": "2026-01-02",
          "note": "unnamed"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "api.schema_invalid",
          "issues": [
            {
              "pointer": "{{inputRulesUnnamedPointer}}",
              "rule": "app.invalid"
            }
          ]
        }
      }
    },
    {
      "script": {
        "hookFailures": {
          "input-rule:endAfterStart": "the rule store is down"
        }
      }
    },
    {
      "title": "a rule that throws answers 500 without its message",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:throws}}"
        },
        "body": {
          "start": "2026-01-01",
          "end": "2026-01-02"
        }
      },
      "expect": {
        "status": 500,
        "body": {
          "code": "api.internal"
        }
      }
    },
    {
      "script": {}
    },
    {
      "title": "the app keeps serving after a throwing rule",
      "request": {
        "method": "POST",
        "path": "/input-rules/v1/channels/10000000-0000-4000-8000-000000000001/tasks/schedule",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:after}}"
        },
        "body": {
          "start": "2026-01-01",
          "end": "2026-01-02"
        }
      },
      "expect": {
        "status": 201
      }
    }
  ]
}
