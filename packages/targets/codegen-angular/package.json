{
  "name": "@seampact/codegen-angular",
  "description": "Seampact target for Angular: generates an injectable api service over HttpClient with signal readers, and opt-in NgRx actions and effects.",
  "license": "MIT",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/targets/codegen-angular"
  },
  "homepage": "https://jubasse.github.io/seampact/frontend/angular/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "keywords": [
    "angular",
    "client",
    "signals",
    "ngrx",
    "seampact",
    "api-contract",
    "openapi",
    "codegen"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*",
    "@angular/common": ">=22",
    "@angular/core": ">=22",
    "@ngrx/effects": ">=22",
    "@ngrx/signals": ">=22",
    "@ngrx/store": ">=22",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@ngrx/effects": {
      "optional": true
    },
    "@ngrx/signals": {
      "optional": true
    },
    "@ngrx/store": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  }
}
