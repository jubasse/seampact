{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!.changeset/*.md",
      "!php/**/composer.lock",
      "!fixtures/rules/load-yaml-syntax",
      "!fixtures/rules/load-workspace-shape"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "includes": [
      "**",
      "!packages/core/spec/schemas/authoring",
      "!packages/core/spec/src/authoring/grammar.snapshot.json",
      "!fixtures/golden",
      "!fixtures/expected"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  }
}
