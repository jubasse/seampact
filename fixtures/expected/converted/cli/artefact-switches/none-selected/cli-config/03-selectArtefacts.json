{
  "function": "selectArtefacts",
  "args": [
    {
      "id": "server",
      "use": "probe-server",
      "api": "tasks",
      "artefacts": {
        "routes": false,
        "nativeDocs": false
      },
      "options": {
        "echo": true
      }
    },
    {
      "metadata": {
        "packageName": "probe-server",
        "packageVersion": "1.0.0",
        "irSupport": {
          "irVersions": [
            1
          ],
          "irRevision": 6,
          "kinds": [
            "httpOperation"
          ],
          "features": []
        },
        "role": "server",
        "artefacts": [
          {
            "id": "routes",
            "defaultOn": true
          },
          {
            "id": "nativeDocs",
            "defaultOn": false
          },
          {
            "id": "hooks",
            "defaultOn": false,
            "needs": [
              "routes"
            ],
            "leftOffWithoutNeeds": true
          }
        ],
        "consumes": {
          "validators": {
            "styles": [
              "standard-schema",
              "class-validator"
            ],
            "optional": {
              "ownLibrary": "ajv"
            }
          }
        },
        "provides": {},
        "bootChecks": [
          "frameworkRoutes",
          "hooks"
        ],
        "frameworkDocsOffFix": "Remove the `probe.docs()` call.",
        "exclusiveBasePaths": true
      }
    }
  ],
  "result": {
    "status": "refused",
    "problems": [
      {
        "code": "config.artefacts.none",
        "message": "The entry leaves off every artefact the target 'probe-server' declares ('routes', 'nativeDocs', 'hooks'), so it would generate nothing.",
        "fix": "Remove the entry from `targets`, or switch one of its artefacts on.",
        "where": "entry 'server'"
      }
    ]
  }
}
