{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seampact.dev/schemas/ir/source-map.schema.json",
  "title": "seampact IR: source-location side table",
  "description": "Source locations, written next to the IR and never inside it (ADR 0004 section 11).",
  "$ref": "#/$defs/SourceMap",
  "$defs": {
    "SourceMap": {
      "type": "object",
      "required": ["irRevision", "locations"],
      "properties": {
        "irRevision": { "type": "integer", "minimum": 1 },
        "locations": {
          "type": "object",
          "description": "Keyed by '<layer>#<pointer>', the serialised form of an Origin.",
          "propertyNames": {
            "type": "string",
            "pattern": "^(api|shared|base|pack:[^#]+)#(/.*)?$"
          },
          "additionalProperties": { "$ref": "#/$defs/SourceLocation" }
        }
      }
    },
    "SourceLocation": {
      "type": "object",
      "description": "A location; 'file' is relative to the workspace root, with forward slashes.",
      "required": ["file", "line", "column", "endLine", "endColumn"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
