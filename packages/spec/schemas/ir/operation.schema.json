{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seampact.dev/schemas/ir/operation.schema.json",
  "title": "seampact IR: the operation",
  "description": "The httpOperation declaration kind (ADR 0004 section 7).",
  "$defs": {
    "HttpMethod": {
      "type": "string",
      "x-seampact-known": ["get", "post", "put", "patch", "delete"]
    },
    "CallerKind": { "type": "string", "x-seampact-known": ["anonymous", "identified"] },
    "OperationRef": {
      "type": "object",
      "description": "A kind-tagged operation reference (ADR 0014).",
      "required": ["kind", "api", "id"],
      "properties": {
        "kind": { "$ref": "common.schema.json#/$defs/DeclarationKind" },
        "api": { "type": "string" },
        "id": { "$ref": "common.schema.json#/$defs/OperationId" }
      }
    },
    "QueryWireKind": {
      "type": "string",
      "description": "How a query value is written (FR-30).",
      "x-seampact-known": ["number", "boolean", "list", "text", "object"]
    },
    "QueryStyle": {
      "type": "string",
      "description": "The OpenAPI style of a query value.",
      "x-seampact-known": ["form", "deepObject"]
    },
    "QueryWire": {
      "type": "object",
      "description": "The wire form of a query parameter (FR-30).",
      "required": ["kind", "style", "explode", "brackets"],
      "properties": {
        "kind": { "$ref": "#/$defs/QueryWireKind" },
        "style": { "$ref": "#/$defs/QueryStyle" },
        "explode": { "type": "boolean" },
        "brackets": { "type": "boolean", "description": "A list sent as 'name[]'." }
      }
    },
    "FieldWireKind": {
      "type": "string",
      "description": "How a form or multipart field is written: a query wire kind, 'file' or 'json'.",
      "x-seampact-known": ["number", "boolean", "list", "text", "object", "file", "json"]
    },
    "FieldWire": {
      "type": "object",
      "description": "The wire form of a form or multipart field: a query wire kind with style, explode and brackets, or kind 'file' or 'json' alone (invariant ir.field-wire.members).",
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/FieldWireKind" },
        "style": { "$ref": "#/$defs/QueryStyle" },
        "explode": { "type": "boolean" },
        "brackets": { "type": "boolean" }
      }
    },
    "Param": {
      "type": "object",
      "description": "A path, query or header parameter, declared (origin) or derived (derivedFrom).",
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "required": { "type": "boolean" },
        "wire": { "$ref": "#/$defs/QueryWire" },
        "default": {},
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "Params": {
      "type": "object",
      "required": ["path", "query", "header"],
      "properties": {
        "path": { "type": "array", "items": { "$ref": "#/$defs/Param" } },
        "query": { "type": "array", "items": { "$ref": "#/$defs/Param" } },
        "header": { "type": "array", "items": { "$ref": "#/$defs/Param" } }
      }
    },
    "UnknownQuery": {
      "type": "object",
      "description": "Undeclared query keys.",
      "discriminator": { "propertyName": "policy" },
      "oneOf": [{ "$ref": "#/$defs/RefuseUnknownQuery" }, { "$ref": "#/$defs/IgnoreUnknownQuery" }],
      "x-seampact-must-act": true
    },
    "RefuseUnknownQuery": {
      "type": "object",
      "required": ["policy"],
      "properties": { "policy": { "type": "string", "const": "refuse" } }
    },
    "IgnoreUnknownQuery": {
      "type": "object",
      "required": ["policy", "reason", "origin"],
      "properties": {
        "policy": { "type": "string", "const": "ignore" },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Access": {
      "type": "object",
      "description": "Who may call the operation.",
      "discriminator": { "propertyName": "kind" },
      "oneOf": [
        { "$ref": "#/$defs/IdentityAccess" },
        { "$ref": "#/$defs/OptionalAccess" },
        { "$ref": "#/$defs/PublicAccess" }
      ],
      "x-seampact-must-act": true
    },
    "IdentityAccess": {
      "type": "object",
      "required": ["kind", "identity", "schemes", "origin"],
      "properties": {
        "kind": { "type": "string", "const": "identity" },
        "identity": { "$ref": "common.schema.json#/$defs/IdentityId" },
        "schemes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/SchemeId" },
          "minItems": 1
        },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "RefusedCredential": {
      "type": "string",
      "description": "What an optional-auth operation does with a refused credential: serve it as anonymous, or answer 401.",
      "x-seampact-known": ["anonymous", "reject"],
      "x-seampact-must-act": true
    },
    "OptionalAccess": {
      "type": "object",
      "required": ["kind", "identity", "schemes", "reason", "onRefused", "origin"],
      "properties": {
        "kind": { "type": "string", "const": "optional" },
        "identity": { "$ref": "common.schema.json#/$defs/IdentityId" },
        "schemes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/SchemeId" },
          "minItems": 1
        },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "onRefused": { "$ref": "#/$defs/RefusedCredential" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "PublicAccess": {
      "type": "object",
      "required": ["kind", "reason", "origin"],
      "properties": {
        "kind": { "type": "string", "const": "public" },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "PrincipalRequirement": {
      "type": "object",
      "required": ["field", "origin"],
      "properties": {
        "field": { "type": "string" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "OperationScope": {
      "type": "object",
      "required": ["scope", "source", "origin"],
      "properties": {
        "scope": { "$ref": "common.schema.json#/$defs/ScopeId" },
        "source": {
          "$ref": "common.schema.json#/$defs/ValueSource",
          "description": "Where the scope id is read; 'in: resolver' for an application resolver."
        },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Requirement": {
      "type": "object",
      "description": "A requirement, in declared order (FR-5).",
      "discriminator": { "propertyName": "kind" },
      "oneOf": [{ "$ref": "#/$defs/RightRequirement" }, { "$ref": "#/$defs/RuleRequirement" }],
      "x-seampact-must-act": true
    },
    "RequirementSubject": {
      "type": "object",
      "required": ["source", "defaulted"],
      "properties": {
        "source": { "$ref": "common.schema.json#/$defs/ValueSource" },
        "defaulted": { "type": "boolean" }
      }
    },
    "RightRequirement": {
      "type": "object",
      "required": ["kind", "right"],
      "properties": {
        "kind": { "type": "string", "const": "right" },
        "right": { "$ref": "common.schema.json#/$defs/RightId" },
        "params": { "description": "Values already validated against the right's params schema." },
        "subject": { "$ref": "#/$defs/RequirementSubject" },
        "entry": {
          "type": "string",
          "description": "The 'requirements' entry it was written through."
        },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "RuleRequirement": {
      "type": "object",
      "required": ["kind", "rule"],
      "properties": {
        "kind": { "type": "string", "const": "rule" },
        "rule": { "$ref": "common.schema.json#/$defs/RuleId" },
        "params": { "description": "Values already validated against the rule's params schema." },
        "bucket": { "$ref": "common.schema.json#/$defs/BucketId" },
        "entry": {
          "type": "string",
          "description": "The 'requirements' entry it was written through."
        },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "Binding": {
      "type": "object",
      "required": ["from", "to", "origin"],
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/ValueSource" },
        "to": { "$ref": "common.schema.json#/$defs/ValueSource" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "InputField": {
      "type": "object",
      "required": ["name", "wire"],
      "properties": { "name": { "type": "string" }, "wire": { "$ref": "#/$defs/FieldWire" } }
    },
    "InputMediaType": {
      "type": "string",
      "description": "The media type of a request body.",
      "x-seampact-known": [
        "application/json",
        "application/x-www-form-urlencoded",
        "multipart/form-data"
      ]
    },
    "OperationInput": {
      "type": "object",
      "description": "The request body.",
      "required": ["media", "schema", "bodyLimitBytes", "rawBody", "origin"],
      "properties": {
        "media": { "$ref": "#/$defs/InputMediaType" },
        "schema": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "bodyLimitBytes": { "type": "integer", "minimum": 0 },
        "rawBody": { "type": "boolean" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/InputField" } },
        "proofs": {
          "type": "array",
          "description": "The body fields of the rule proofs read in the body, each once, in requirement order; absent when there is none. Targets render the body as the input schema's properties followed by these fields.",
          "items": { "$ref": "#/$defs/InputProof" }
        },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "InputProof": {
      "type": "object",
      "description": "A body field the compiler adds to the input for a rule proof read in the body (derivation 'rule.proof'): required and sensitive (ADR 0002 section 9). A proof read in a header is a derived header parameter.",
      "required": ["name", "schema", "derivedFrom"],
      "properties": {
        "name": { "type": "string" },
        "schema": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "wire": {
          "$ref": "#/$defs/FieldWire",
          "description": "The proof's wire form, as an input field's: present exactly when the input's media is form or multipart, and never of kind 'file' (invariant ir.input-proof.wire)."
        },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "ResponseHeader": {
      "type": "object",
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "required": { "type": "boolean" },
        "semantic": { "type": "string" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "ResponseShape": {
      "type": "string",
      "description": "The format shape of a response; 'binary' and 'redirect' bypass the format (ADR 0004 section 8).",
      "x-seampact-known": ["item", "table", "list", "page", "empty", "binary", "redirect"]
    },
    "Response": {
      "type": "object",
      "description": "A success or derived non-error response.",
      "required": ["status", "shape", "headers"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "media": { "type": "string", "description": "Absent for an empty body." },
        "body": { "$ref": "schemas.schema.json#/$defs/TypeUse" },
        "shape": { "$ref": "#/$defs/ResponseShape" },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/ResponseHeader" } },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "OperationError": {
      "type": "object",
      "description": "A code the operation can answer, declared or derived.",
      "required": ["code"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/ErrorCode" },
        "example": {},
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "FieldRightSubject": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/ValueSource",
          "description": "Where the subject is read; 'in: holderField' names the holder's property on output."
        }
      }
    },
    "FieldRight": {
      "type": "object",
      "description": "A field right, materialised so targets never walk schemas (FR-23).",
      "required": ["schema", "pointer", "right", "direction", "derivedFrom"],
      "properties": {
        "schema": { "$ref": "common.schema.json#/$defs/SchemaId" },
        "pointer": { "type": "string" },
        "right": { "$ref": "common.schema.json#/$defs/RightId" },
        "params": {},
        "subject": { "$ref": "#/$defs/FieldRightSubject" },
        "direction": { "$ref": "common.schema.json#/$defs/Direction" },
        "inputPolicy": { "$ref": "schemas.schema.json#/$defs/InputPolicy" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "Idempotency": {
      "type": "object",
      "description": "The idempotency key of an unsafe operation: derived settings, or an exemption with its reason.",
      "discriminator": { "propertyName": "kind" },
      "oneOf": [{ "$ref": "#/$defs/DerivedIdempotency" }, { "$ref": "#/$defs/ExemptIdempotency" }],
      "x-seampact-must-act": true
    },
    "IdempotencyEnforcement": {
      "type": "string",
      "description": "Where the idempotency key is enforced.",
      "x-seampact-known": ["boundary", "none"]
    },
    "DerivedIdempotency": {
      "type": "object",
      "required": [
        "kind",
        "header",
        "replayHeader",
        "lifetimeMs",
        "required",
        "enforce",
        "derivedFrom"
      ],
      "properties": {
        "kind": { "type": "string", "const": "derived" },
        "header": { "type": "string" },
        "replayHeader": { "type": "string" },
        "lifetimeMs": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" },
        "enforce": { "$ref": "#/$defs/IdempotencyEnforcement" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "ExemptIdempotency": {
      "type": "object",
      "required": ["kind", "reason", "origin"],
      "properties": {
        "kind": { "type": "string", "const": "exempt" },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Concurrency": {
      "type": "object",
      "required": ["version", "field", "derivedFrom"],
      "properties": {
        "version": { "$ref": "common.schema.json#/$defs/ValueSource" },
        "field": { "type": "string" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "OwnerKind": {
      "type": "string",
      "description": "Who owns the resource an operation writes.",
      "x-seampact-known": ["caller"]
    },
    "Owner": {
      "type": "object",
      "required": ["kind", "origin"],
      "properties": {
        "kind": { "$ref": "#/$defs/OwnerKind" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "CacheDirectives": {
      "type": "object",
      "required": ["maxAgeMs", "immutable", "noCache", "mustRevalidate"],
      "properties": {
        "maxAgeMs": { "type": "integer", "minimum": 0 },
        "sharedMaxAgeMs": { "type": "integer", "minimum": 0 },
        "staleWhileRevalidateMs": { "type": "integer", "minimum": 0 },
        "staleIfErrorMs": { "type": "integer", "minimum": 0 },
        "immutable": { "type": "boolean" },
        "noCache": { "type": "boolean" },
        "mustRevalidate": { "type": "boolean" }
      }
    },
    "CallerCacheControl": {
      "type": "object",
      "required": ["caller", "cacheControl"],
      "properties": {
        "caller": { "$ref": "#/$defs/CallerKind" },
        "cacheControl": { "type": "string" }
      }
    },
    "CacheVisibility": {
      "type": "string",
      "description": "Whether a shared cache may store an anonymous response.",
      "x-seampact-known": ["public", "private"]
    },
    "Cache": {
      "type": "object",
      "description": "Cache settings (ADR 0004 section 7).",
      "required": ["family", "anonymous", "vary", "etag", "perCallerKind", "noStore", "origin"],
      "properties": {
        "family": { "type": "string" },
        "directives": {
          "$ref": "#/$defs/CacheDirectives",
          "description": "Absent if and only if the family is 'never' (invariant ir.cache.directives)."
        },
        "anonymous": { "$ref": "#/$defs/CacheVisibility" },
        "vary": { "type": "array", "items": { "type": "string" } },
        "etag": { "type": "boolean" },
        "perCallerKind": { "type": "array", "items": { "$ref": "#/$defs/CallerCacheControl" } },
        "noStore": {
          "type": "boolean",
          "description": "Authoritative: when true the response is never stored, whatever 'directives' hold. True when the family is 'never' or a response carries a sensitive field (ADR 0003 section 6)."
        },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "SortKey": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "right": { "$ref": "common.schema.json#/$defs/RightId" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "OverLimitPolicy": {
      "type": "string",
      "description": "What a limit above maxLimit does.",
      "x-seampact-known": ["reject", "clamp"]
    },
    "PagingToken": {
      "type": "string",
      "description": "What a paging token holds.",
      "x-seampact-known": ["opaque", "instant"]
    },
    "Paging": {
      "type": "object",
      "description": "The paging of a list; 'style' is absent for an unpaged list.",
      "required": ["overLimit", "sortKeys", "origin"],
      "properties": {
        "style": { "$ref": "common.schema.json#/$defs/PagingId" },
        "maxLimit": { "type": "integer", "minimum": 0 },
        "defaultLimit": { "type": "integer", "minimum": 0 },
        "overLimit": { "$ref": "#/$defs/OverLimitPolicy" },
        "token": { "$ref": "#/$defs/PagingToken" },
        "sortKeys": { "type": "array", "items": { "$ref": "#/$defs/SortKey" } },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Csrf": {
      "type": "object",
      "description": "The CSRF check of an unsafe operation reached through a cookie scheme: the derived header, or an exemption with its reason (invariant ir.csrf.cookie).",
      "discriminator": { "propertyName": "kind" },
      "oneOf": [{ "$ref": "#/$defs/DerivedCsrf" }, { "$ref": "#/$defs/ExemptCsrf" }],
      "x-seampact-must-act": true
    },
    "DerivedCsrf": {
      "type": "object",
      "required": ["kind", "header", "derivedFrom"],
      "properties": {
        "kind": { "type": "string", "const": "derived" },
        "header": { "type": "string" },
        "derivedFrom": { "$ref": "common.schema.json#/$defs/DerivedFrom" }
      }
    },
    "ExemptCsrf": {
      "type": "object",
      "required": ["kind", "reason", "origin"],
      "properties": {
        "kind": { "type": "string", "const": "exempt" },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Degradable": {
      "type": "object",
      "required": ["paths", "origin"],
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" } },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "Deprecation": {
      "type": "object",
      "required": ["sunset", "origin"],
      "properties": {
        "sunset": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "successor": { "$ref": "#/$defs/OperationRef" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "MaturitySource": {
      "type": "string",
      "description": "Where an operation's maturity comes from.",
      "x-seampact-known": ["api", "upstream", "stated"]
    },
    "OperationMaturity": {
      "type": "object",
      "required": ["level", "source", "origin"],
      "properties": {
        "level": { "$ref": "common.schema.json#/$defs/Maturity" },
        "source": { "$ref": "#/$defs/MaturitySource" },
        "reason": { "$ref": "common.schema.json#/$defs/Reason" },
        "origin": { "$ref": "common.schema.json#/$defs/Origin" }
      }
    },
    "OperationResource": {
      "type": "object",
      "description": "The collection or single it belongs to.",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "idParam": { "type": "string" },
        "idProperty": { "type": "string" }
      }
    },
    "OperationExample": {
      "type": "object",
      "description": "A route example; with 'error', 'value' holds the code's params.",
      "required": ["value"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "request": { "type": "boolean" },
        "error": { "$ref": "common.schema.json#/$defs/ErrorCode" },
        "value": {}
      }
    },
    "OpShorthand": {
      "type": "string",
      "description": "The ops shorthand an operation came from.",
      "x-seampact-known": ["list", "get", "create", "update", "delete", "batch"]
    },
    "Operation": {
      "type": "object",
      "description": "An HTTP operation (ADR 0004 section 7).",
      "required": [
        "kind",
        "id",
        "name",
        "surface",
        "features",
        "method",
        "path",
        "safe",
        "params",
        "unknownQuery",
        "access",
        "callerKinds",
        "principalRequires",
        "scopes",
        "requires",
        "bindings",
        "responses",
        "errors",
        "fieldRights",
        "upstream",
        "maturity",
        "internal",
        "format",
        "tags",
        "examples",
        "docs",
        "extensions",
        "origin"
      ],
      "properties": {
        "kind": { "$ref": "common.schema.json#/$defs/DeclarationKind" },
        "id": { "$ref": "common.schema.json#/$defs/OperationId" },
