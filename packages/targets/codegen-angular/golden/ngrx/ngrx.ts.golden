// A rejection as an `Error`, the value kept as its cause when it is not one.
function asError(rejection: unknown): Error {
  return rejection instanceof Error
    ? rejection
    : new Error(String(rejection), { cause: rejection });
}

// The success or failure of one call; an error never leaves the stream. A call `superseded` aborts ends in its
// failure with the abort error; unsubscribing, as an effect's or a store's teardown does, aborts it with no outcome.
function outcomeOf<Data, Succeeded, Failed>(
  send: (signal: AbortSignal) => Promise<Data>,
  succeeded: (data: Data) => Succeeded,
  failed: (error: Error) => Failed,
  superseded: Observable<unknown> = NEVER,
): Observable<Succeeded | Failed> {
  return new Observable<Succeeded | Failed>((subscriber) => {
    const controller = new AbortController();
    let settled = false;

    subscriber.add(superseded.subscribe(() => controller.abort()));

    void new Promise<Data>((resolve) => {
      resolve(send(controller.signal));
    }).then(
      (data) => {
        settled = true;
        subscriber.next(succeeded(data));
        subscriber.complete();
      },
      (rejection: unknown) => {
        settled = true;
        subscriber.next(failed(asError(rejection)));
        subscriber.complete();
      },
    );

    return () => {
      if (!settled) controller.abort();
    };
  });
}

// Per request key, the latest read wins: a read of the same request aborts the one still waiting, which ends in its
// failure; reads of other requests run side by side. A request's group closes once none of its reads waits.
function latestReadPerRequest<Action, Outcome>(
  keyOf: (action: Action) => string,
  read: (action: Action, superseded: Observable<Action>) => Observable<Outcome>,
): OperatorFunction<Action, Outcome> {
  return (actions) =>
    defer(() => {
      const idleKeys = new Subject<string>();

      return actions.pipe(
        groupBy(keyOf, {
          duration: (group) =>
            idleKeys.pipe(filter((idleKey) => idleKey === group.key)),
        }),
        mergeMap((group) => {
          let waiting = 0;

          return group.pipe(
            mergeMap((action) => {
              waiting += 1;

              return read(action, group.pipe(take(1))).pipe(
                finalize(() => {
                  waiting -= 1;
                  if (waiting === 0) idleKeys.next(group.key);
                }),
              );
            }),
          );
        }),
      );
    });
}

// The request with the idempotency key a write action gives; without one, the service draws a key per action.
function requestWithActionKey<Request extends object | undefined>(
  request: Request,
  headerKey: string,
  idempotencyKey: string | undefined,
): Request {
  if (idempotencyKey === undefined) return request;

  return runtimeWithIdempotencyKey(request, headerKey, () => idempotencyKey);
}

