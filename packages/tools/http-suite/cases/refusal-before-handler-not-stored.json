{
  "id": "refusal-before-handler-not-stored",
  "title": "A refusal before the handler is not stored: the key then serves a valid request",
  "checks": ["CHK-149"],
  "profiles": ["default"],
  "steps": [
    {
      "title": "refused",
      "request": {
        "method": "POST",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001/tasks",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:create}}"
        },
        "body": {
          "title": ""
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "api.schema_invalid"
        }
      }
    },
    {
      "title": "same key, a valid body",
      "request": {
        "method": "POST",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001/tasks",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:create}}"
        },
        "body": {
          "title": "Valid now"
        }
      },
      "expect": {
        "status": 201,
        "headers": {
          "idempotency-replayed": {
            "excludes": "true"
          }
        }
      }
    }
  ]
}
