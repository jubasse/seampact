{
  "name": "@seampact/cli",
  "description": "The seampact command: compile a YAML API contract and generate typed server code, validators, OpenAPI and clients, then check them in CI.",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/core/cli"
  },
  "homepage": "https://jubasse.github.io/seampact/getting-started/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "keywords": [
    "cli",
    "contract-first",
    "seampact",
    "api-contract",
    "openapi",
    "codegen"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "bin": {
    "seampact": "./src/bin.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "seampact": "./dist/bin.js"
    }
  },
  "seampact": {
    "role": "core"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/compiler": "workspace:*",
    "@seampact/diff": "workspace:*",
    "@seampact/lint": "workspace:*",
    "@seampact/openapi": "workspace:*",
    "@seampact/spec": "workspace:*",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
