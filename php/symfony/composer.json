{
  "name": "seampact/symfony",
  "description": "The Seampact Symfony target: generates the types, controller interfaces, routes, constraints and bundle of a contract for Symfony 7.4 and 8.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3.36 <8.4 || >=8.4.27 <8.5 || >=8.5.12",
    "ext-json": "*",
    "nette/php-generator": "~4.2.0",
    "seampact/codegen": "self.version",
    "seampact/ir": "self.version"
  },
  "require-dev": {
    "phpstan/phpstan": "2.2.16",
    "phpunit/phpunit": "11.5.56",
    "seampact/hooks": "self.version",
    "symfony/framework-bundle": "7.4.21",
    "symfony/http-kernel": "7.4.21",
    "symfony/routing": "7.4.21",
    "symfony/validator": "7.4.21"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../codegen",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../ir",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../hooks",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "Seampact\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Seampact\\Symfony\\Runtime\\": "runtime/",
      "Seampact\\Symfony\\Tests\\": "tests/",
      "Seampact\\Codegen\\Tests\\Support\\": "../codegen/tests/Support/",
      "Seampact\\Golden\\": "tests/golden/"
    }
  },
  "extra": {
    "seampact": {
      "generator": "Seampact\\Symfony\\SymfonyGenerator"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.36"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
