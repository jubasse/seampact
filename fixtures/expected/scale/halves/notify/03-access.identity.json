      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "shared",
        "pointer": "/identities/partner"
      }
    },
    "webhook": {
      "id": "webhook",
      "kind": "signed",
      "signed": "webhookSignature",
      "principal": {
        "kind": "schema",
        "schema": "WebhookCaller"
      },
      "errors": [],
      "headers": [],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "shared",
        "pointer": "/identities/webhook"
      }
    }
  },
