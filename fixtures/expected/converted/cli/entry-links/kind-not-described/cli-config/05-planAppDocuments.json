{
  "function": "planAppDocuments",
  "args": [
    {
      "file": "<root>/seampact.config.yaml",
      "outDir": "<root>/__generated__",
      "sources": {
        "a": {
          "kind": "path",
          "directory": "<root>/a"
        }
      },
      "entries": [
        {
          "entry": {
            "id": "shared",
            "use": "probe-provider",
            "api": "tasks"
          },
          "root": "<root>/__generated__/shared"
        },
        {
          "entry": {
            "id": "server",
            "use": "probe-server",
            "api": "tasks",
            "link": {
              "validators": "shared"
            }
          },
          "root": "<root>/__generated__/server"
        }
      ]
    },
    {
      "shared": "provider",
      "server": "server"
    },
    [
      {
        "source": "a",
        "api": "tasks",
        "documents": [
          "full",
          "public"
        ]
      }
    ]
  ],
  "result": {
    "status": "planned",
    "documents": [
      {
        "source": "a",
        "api": "tasks",
        "document": "full",
        "file": "<root>/openapi/tasks.full.yaml",
        "options": {}
      },
      {
        "source": "a",
        "api": "tasks",
        "document": "public",
        "file": "<root>/openapi/tasks.public.yaml",
        "options": {}
      }
    ]
  }
}
