{
  "id": "owner-caller-other-id-not-found",
  "title": "Another caller's id on an owner caller collection answers the derived 404, with no version asked",
  "checks": ["CHK-040"],
  "profiles": ["default", "hand-written"],
  "script": {
    "answers": {
      "tasks.getDraft": {
        "status": 404,
        "code": "api.not_found"
      },
      "tasks.deleteDraft": {
        "status": 404,
        "code": "api.not_found"
      }
    }
  },
  "steps": [
    {
      "title": "read another caller's draft",
      "request": {
        "method": "GET",
        "path": "/v1/me/drafts/30000000-0000-4000-8000-000000000002",
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "code": "api.not_found"
        }
      }
    },
    {
      "title": "delete another caller's draft without a version",
      "request": {
        "method": "DELETE",
        "path": "/v1/me/drafts/30000000-0000-4000-8000-000000000002",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:delete}}"
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "code": "api.not_found"
        }
      }
    }
  ],
  "hookCalls": [
    {
      "hook": "authenticate:user",
      "operation": "tasks.getDraft"
    },
    {
      "hook": "authenticate:user",
      "operation": "tasks.deleteDraft"
    }
  ]
}
