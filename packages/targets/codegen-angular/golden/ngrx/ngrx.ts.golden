                }),
              superseded,
            ),
        ),
      ),
    { functional: true },
  ),

  payments: createEffect(
    (actions = inject(Actions), api = inject(TasksApi)) =>
      actions.pipe(
        ofType(TasksApiActions.payments),
        mergeMap((action) =>
          outcomeOf(
            () =>
              api.queries
                .paymentsMutationOptions(action.call)
                .fetcher(action.request, action),
            (data) =>
              TasksApiActions.paymentsSuccess({
                request: action.request,
                data,
              }),
            (error) =>
              TasksApiActions.paymentsFailure({
                request: action.request,
                error,
              }),
          ),
        ),
      ),
    { functional: true },
  ),
};

/** The effects of `TasksEffects`, to list in the app's providers beside `provideStore()` and `provideTasksApi()`. */
export function provideTasksEffects(): EnvironmentProviders {
  return provideEffects(TasksEffects);
}
