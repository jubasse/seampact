{
  "name": "@seampact/spec",
  "description": "The JSON Schemas of the YAML files and of the IR, with their TypeScript types, the naming vectors and the bundle vectors.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "schemas",
    "vectors/naming",
    "vectors/bundle"
  ],
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ir": "./src/ir/index.ts",
    "./authoring": "./src/authoring/index.ts",
    "./naming": "./src/naming/index.ts",
    "./config": "./src/config/index.ts",
    "./bundle": "./src/bundle/index.ts",
    "./compatibility": "./src/compatibility/index.ts",
    "./json": "./src/json/index.ts",
    "./schemas/*.json": "./schemas/*.json",
    "./naming/vectors.json": "./vectors/naming/vectors.json",
    "./naming/vectors.schema.json": "./vectors/naming/vectors.schema.json",
    "./naming/reserved-words.json": "./vectors/naming/reserved-words.json",
    "./naming/reserved-words.schema.json": "./vectors/naming/reserved-words.schema.json",
    "./bundle/vectors/*.json": "./vectors/bundle/*.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ir": {
        "types": "./dist/ir/index.d.ts",
        "default": "./dist/ir/index.js"
      },
      "./authoring": {
        "types": "./dist/authoring/index.d.ts",
        "default": "./dist/authoring/index.js"
      },
      "./naming": {
        "types": "./dist/naming/index.d.ts",
        "default": "./dist/naming/index.js"
      },
      "./config": {
        "types": "./dist/config/index.d.ts",
        "default": "./dist/config/index.js"
      },
      "./bundle": {
        "types": "./dist/bundle/index.d.ts",
        "default": "./dist/bundle/index.js"
      },
      "./compatibility": {
        "types": "./dist/compatibility/index.d.ts",
        "default": "./dist/compatibility/index.js"
      },
      "./json": {
        "types": "./dist/json/index.d.ts",
        "default": "./dist/json/index.js"
      },
      "./schemas/*.json": "./schemas/*.json",
      "./naming/vectors.json": "./vectors/naming/vectors.json",
      "./naming/vectors.schema.json": "./vectors/naming/vectors.schema.json",
      "./naming/reserved-words.json": "./vectors/naming/reserved-words.json",
      "./naming/reserved-words.schema.json": "./vectors/naming/reserved-words.schema.json",
      "./bundle/vectors/*.json": "./vectors/bundle/*.json"
    }
  },
  "seampact": {
    "role": "core"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
