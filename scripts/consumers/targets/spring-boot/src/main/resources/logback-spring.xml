<?xml version="1.0" encoding="UTF-8"?>
<!-- Boot's console logging, plus the appender behind the suite's log-lines control route. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <appender name="LOG_LINES" class="com.example.consumer.LogLinesAppender"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOG_LINES"/>
    </root>
</configuration>
