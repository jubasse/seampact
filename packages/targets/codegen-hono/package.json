{
  "name": "@seampact/codegen-hono",
  "description": "Seampact target for Hono 4: generates a registerRoutes function that adds each contract route with access, validation and reply checks around your handler map.",
  "license": "MIT",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubasse/seampact.git",
    "directory": "packages/targets/codegen-hono"
  },
  "homepage": "https://jubasse.github.io/seampact/backend/hono/",
  "bugs": {
    "url": "https://github.com/jubasse/seampact/issues"
  },
  "keywords": [
    "hono",
    "server",
    "validation",
    "seampact",
    "api-contract",
    "openapi",
    "codegen"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.6",
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*",
    "@types/node": "24.19.2",
    "hono": "4.13.16",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
