{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seampact.dev/schemas/openapi/extensions/apis.schema.json",
  "title": "x-seampact-apis",
  "description": "The apis a merged document holds, each with its name, kind, role and caller.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string",
        "minLength": 1
      },
      "caller": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["identity", "right"],
        "additionalProperties": false
      }
    },
    "required": ["name", "kind"],
    "additionalProperties": false
  }
}
