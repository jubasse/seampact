{
  "id": "pack-laravel-page-next-link",
  "title": "A page is fetched with the laravel request names and its next link is followed",
  "checks": ["CHK-107"],
  "profiles": ["pack:laravel"],
  "steps": [
    {
      "title": "first page",
      "request": {
        "method": "GET",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001/tasks",
        "query": {
          "per_page": 2,
          "page": 1
        },
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "capture": {
        "nextPage": {
          "body": "/links/next"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "current_page": 1,
            "per_page": 2
          }
        }
      }
    },
    {
      "title": "the next link",
      "request": {
        "method": "GET",
        "path": "{{nextPage}}",
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "meta": {
            "current_page": 2,
            "per_page": 2
          }
        }
      }
    }
  ]
}
