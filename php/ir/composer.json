{
  "name": "seampact/ir",
  "description": "The Seampact IR model and reader for PHP.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-json": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "2.2.16",
    "phpunit/phpunit": "11.5.56"
  },
  "autoload": {
    "psr-4": {
      "Seampact\\Ir\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Seampact\\Ir\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
