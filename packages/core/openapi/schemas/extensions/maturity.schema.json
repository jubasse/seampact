{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seampact.dev/schemas/openapi/extensions/maturity.schema.json",
  "title": "x-seampact-maturity",
  "description": "The operation's maturity, where it comes from, and its reason.",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["level", "source"],
  "additionalProperties": false
}
