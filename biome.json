{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!pnpm-lock.yaml", "!.changeset/*.md"] },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "includes": [
      "**",
      "!packages/spec/schemas/authoring/**",
      "!packages/spec/src/authoring/grammar.snapshot.json"
    ]
  },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
