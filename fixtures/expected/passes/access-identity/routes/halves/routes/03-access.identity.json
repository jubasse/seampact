{
  "schemes": {
    "sessionCookie": {
      "id": "sessionCookie",
      "kind": "cookie",
      "name": "__Host-session",
      "csrf": "csrfToken",
      "origin": {
        "layer": "api",
        "pointer": "/schemes/sessionCookie"
      }
    },
    "csrfToken": {
      "id": "csrfToken",
      "kind": "header",
      "name": "X-Csrf-Token",
      "origin": {
        "layer": "api",
        "pointer": "/schemes/csrfToken"
      }
    },
    "bearer": {
      "id": "bearer",
      "kind": "bearer",
      "origin": {
        "layer": "api",
        "pointer": "/schemes/bearer"
      }
    },
    "deviceToken": {
      "id": "deviceToken",
      "kind": "header",
      "name": "X-Device-Token",
      "origin": {
        "layer": "api",
        "pointer": "/schemes/deviceToken"
      }
    },
    "mapsKey": {
      "id": "mapsKey",
      "kind": "query",
      "name": "key",
      "origin": {
        "layer": "api",
        "pointer": "/schemes/mapsKey"
      }
    },
    "stripeSignature": {
      "id": "stripeSignature",
      "kind": "signature",
      "name": "Stripe-Signature",
      "signature": {
        "verify": "template",
        "format": "t={ts},v1={sig}",
        "algorithm": "hmac-sha256",
        "payload": "{ts}.{rawBody}",
        "encoding": "hex",
        "toleranceMs": 300000,
        "key": {
          "kind": "value",
          "value": "stripe"
        }
      },
      "origin": {
        "layer": "api",
        "pointer": "/schemes/stripeSignature"
      }
    },
    "clerkWebhook": {
      "id": "clerkWebhook",
      "kind": "signature",
      "name": "svix-signature",
      "signature": {
        "verify": "application",
        "headers": [
          "svix-id",
          "svix-timestamp"
        ]
      },
      "origin": {
        "layer": "api",
        "pointer": "/schemes/clerkWebhook"
      }
    },
    "slackSignature": {
      "id": "slackSignature",
      "kind": "signature",
      "name": "X-Slack-Signature",
      "signature": {
        "verify": "application",
        "headers": [
          "X-Slack-Request-Timestamp"
        ]
      },
      "origin": {
        "layer": "api",
        "pointer": "/schemes/slackSignature"
      }
    }
  },
  "identities": {
    "viewer_or_device": {
      "id": "viewer_or_device",
      "kind": "credential",
      "schemes": {
        "read": [
          "bearer",
          "sessionCookie"
        ],
        "write": [
          "bearer",
          "sessionCookie"
        ],
        "optionalRead": [
          "deviceToken"
        ]
      },
      "principal": {
        "kind": "variants",
        "variants": {
          "viewer": "ViewerPrincipal",
          "device": "DevicePrincipal"
        }
      },
      "errors": [],
      "headers": [],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "api",
        "pointer": "/identities/viewer_or_device"
      }
    },
    "partner": {
      "id": "partner",
      "kind": "credential",
      "schemes": {
        "read": [
          "mapsKey"
        ],
        "write": [],
        "optionalRead": []
      },
      "principal": {
        "kind": "schema",
        "schema": "PartnerPrincipal"
      },
      "errors": [],
      "headers": [],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "api",
        "pointer": "/identities/partner"
      }
    },
    "stripe": {
      "id": "stripe",
      "kind": "signed",
      "signed": "stripeSignature",
      "principal": {
        "kind": "schema",
        "schema": "WebhookCaller"
      },
      "errors": [],
      "headers": [],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "api",
        "pointer": "/identities/stripe"
      }
    },
    "clerk": {
      "id": "clerk",
      "kind": "signed",
      "signed": "clerkWebhook",
      "unknownKeys": {
        "policy": "keep",
        "reason": "Clerk adds event fields the handler forwards."
      },
      "principal": {
        "kind": "schema",
        "schema": "WebhookCaller"
      },
      "errors": [],
      "headers": [],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "api",
        "pointer": "/identities/clerk"
      }
    },
    "slack": {
      "id": "slack",
      "kind": "signed",
      "signed": "slackSignature",
      "principal": {
        "kind": "schema",
        "schema": "WebhookCaller"
      },
      "errors": [],
      "headers": [],
      "docs": {},
      "extensions": {},
      "origin": {
        "layer": "api",
        "pointer": "/identities/slack"
      }
    }
  },
  "operations": {
    "health": {
      "access": {
        "kind": "public",
        "reason": "Probes call it before any user exists.",
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/app/routes/health/access"
        }
      },
      "callerKinds": [
        "anonymous"
      ],
      "principalRequires": [],
      "bindings": []
    },
    "feed": {
      "access": {
        "kind": "optional",
        "identity": "viewer_or_device",
        "schemes": [
          "bearer",
          "deviceToken",
          "sessionCookie"
        ],
        "reason": "Anonymous readers see the public notes.",
        "onRefused": "anonymous",
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/app/routes/feed/access"
        }
      },
      "callerKinds": [
        "anonymous",
        "identified"
      ],
      "principalRequires": [],
      "bindings": []
    },
    "notes": {
      "input": {
        "rawBody": false
      },
      "access": {
        "kind": "identity",
        "identity": "viewer_or_device",
        "schemes": [
          "bearer",
          "sessionCookie"
        ],
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/app/identity"
        }
      },
      "callerKinds": [
        "identified"
      ],
      "csrf": {
        "kind": "derived",
        "header": "X-Csrf-Token",
        "derivedFrom": {
          "derivation": "csrf.cookieWrite",
          "from": [
            {
              "layer": "api",
              "pointer": "/identities/viewer_or_device"
            },
            {
              "layer": "api",
              "pointer": "/schemes/sessionCookie"
            }
          ]
        }
      },
      "principalRequires": [
        {
          "field": "workspaceId",
          "origin": {
            "layer": "api",
            "pointer": "/surfaces/app/routes/notes/principal/requires/0"
          }
        }
      ],
      "bindings": [
        {
          "from": {
            "in": "body",
            "name": "workspaceId"
          },
          "to": {
            "in": "principal",
            "name": "workspaceId"
          },
          "origin": {
            "layer": "api",
            "pointer": "/surfaces/app/routes/notes/bindings/body.workspaceId"
          }
        }
      ]
    },
    "logout": {
      "access": {
        "kind": "identity",
        "identity": "viewer_or_device",
        "schemes": [
          "bearer",
          "sessionCookie"
        ],
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/app/identity"
        }
      },
      "callerKinds": [
        "identified"
      ],
      "csrf": {
        "kind": "exempt",
        "reason": "Logging out with a forged request only signs the caller out.",
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/app/routes/logout/csrf"
        }
      },
      "principalRequires": [],
      "bindings": []
    },
    "tiles": {
      "access": {
        "kind": "identity",
        "identity": "partner",
        "schemes": [
          "mapsKey"
        ],
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/partner/identity"
        }
      },
      "callerKinds": [
        "identified"
      ],
      "principalRequires": [],
      "bindings": []
    },
    "stripe": {
      "input": {
        "rawBody": true
      },
      "access": {
        "kind": "identity",
        "identity": "stripe",
        "schemes": [
          "stripeSignature"
        ],
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/hooks/routes/stripe/identity"
        }
      },
      "callerKinds": [
        "identified"
      ],
      "principalRequires": [],
      "bindings": []
    },
    "clerk": {
      "input": {
        "schema": {
          "unknownKeys": {
            "policy": "keep",
            "reason": "Clerk adds event fields the handler forwards.",
            "derivedFrom": {
              "derivation": "identity.unknownKeys",
              "from": [
                {
                  "layer": "api",
                  "pointer": "/identities/clerk"
                }
              ]
            }
          }
        },
        "rawBody": true
      },
      "access": {
        "kind": "identity",
        "identity": "clerk",
        "schemes": [
          "clerkWebhook"
        ],
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/hooks/routes/clerk/identity"
        }
      },
      "callerKinds": [
        "identified"
      ],
      "principalRequires": [],
      "bindings": []
    },
    "slack": {
      "input": {
        "rawBody": true
      },
      "access": {
        "kind": "identity",
        "identity": "slack",
        "schemes": [
          "slackSignature"
        ],
        "origin": {
          "layer": "api",
          "pointer": "/surfaces/hooks/routes/slack/identity"
        }
      },
      "callerKinds": [
        "identified"
      ],
      "principalRequires": [],
      "bindings": []
    }
  }
}
