{
  "schemes": {
    "sessionCookie": {
      "id": "sessionCookie",
      "kind": "cookie",
      "name": "__Host-session",
      "csrf": "csrfToken",
      "origin": {
        "layer": "shared",
        "pointer": "/schemes/sessionCookie"
      }
    },
    "csrfToken": {
      "id": "csrfToken",
      "kind": "header",
      "name": "X-Csrf-Token",
      "origin": {
        "layer": "shared",
        "pointer": "/schemes/csrfToken"
      }
    },
    "bearer": {
      "id": "bearer",
      "kind": "bearer",
      "origin": {
        "layer": "shared",
        "pointer": "/schemes/bearer"
      }
    },
    "internalToken": {
      "id": "internalToken",
      "kind": "bearer",
      "bearer": {
        "format": "jwt"
      },
      "origin": {
        "layer": "shared",
        "pointer": "/schemes/internalToken"
      }
    },
    "stripeSignature": {
      "id": "stripeSignature",
      "kind": "signature",
      "name": "Stripe-Signature",
      "signature": {
        "verify": "template",
        "format": "t={ts},v1={sig}",
        "algorithm": "hmac-sha256",
        "payload": "{ts}.{rawBody}",
        "encoding": "hex",
        "toleranceMs": 300000,
        "key": {
          "kind": "value",
          "value": "stripe"
        }
      },
      "origin": {
        "layer": "shared",
        "pointer": "/schemes/stripeSignature"
      }
    }
  },
  "headers": {
    "deadline": {
      "id": "deadline",
      "semantic": "deadline",
      "name": "X-Deadline",
      "in": "request",
      "origin": {
        "layer": "shared",
        "pointer": "/headers/deadline"
      }
    },
    "trace": {
      "id": "trace",
      "semantic": "traceContext",
      "name": "traceparent",
      "in": "request",
      "origin": {
        "layer": "shared",
        "pointer": "/headers/trace"
      }
    },
    "actorSurface": {
      "id": "actorSurface",
      "semantic": "actorSurface",
      "name": "X-Actor-Surface",
      "in": "request",
      "origin": {
        "layer": "shared",
        "pointer": "/headers/actorSurface"
      }
    }
  },
  "identities": {
    "user": {
      "id": "user",
