{
  "name": "@seampact/codegen-hono",
  "description": "Generates a registerRoutes function per api that adds each contract route to a Hono 4 app with its access, validation and reply checks around your handler map, validating with zod.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.5",
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*",
    "@types/node": "24.19.1",
    "hono": "4.13.13",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
