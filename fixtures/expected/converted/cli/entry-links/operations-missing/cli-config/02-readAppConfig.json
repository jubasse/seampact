{
  "function": "readAppConfig",
  "args": [
    "<root>/seampact.config.yaml",
    "seampact.config.yaml",
    null
  ],
  "result": {
    "status": "read",
    "config": {
      "file": "<root>/seampact.config.yaml",
      "outDir": "<root>/__generated__",
      "sources": {
        "a": {
          "kind": "path",
          "directory": "<root>/a"
        }
      },
      "entries": [
        {
          "entry": {
            "id": "shared",
            "use": "probe-provider",
            "api": "tasks",
            "operations": {
              "include": [
                "health"
              ]
            },
            "options": {
              "echo": true,
              "descriptors": {
                "validators": {
                  "kind": "validators",
                  "style": "standard-schema",
                  "schemas": {},
                  "operations": {}
                },
                "types": {
                  "kind": "types",
                  "style": "typescript",
                  "schemas": {},
                  "operations": {}
                },
                "client": {
                  "kind": "client",
                  "style": "fetch",
                  "errorStyle": "result",
                  "exports": {
                    "createClient": {
                      "module": "client",
                      "export": "createClient"
                    },
                    "Client": {
                      "module": "client",
                      "export": "Client"
                    },
                    "ContractError": {
                      "module": "client",
                      "export": "ContractError"
                    },
                    "CallOptions": {
                      "module": "client",
                      "export": "CallOptions"
                    }
                  },
                  "operations": {}
                }
              }
            }
          },
          "root": "<root>/__generated__/shared"
        },
        {
          "entry": {
            "id": "server",
            "use": "probe-server",
            "api": "tasks",
            "link": {
              "validators": "shared"
            }
          },
          "root": "<root>/__generated__/server"
        }
      ]
    }
  }
}
