{
  "id": "optional-auth-refused-credential",
  "title": "An optionalAuth route reads a refused credential as a visitor, and answers 401 for it with onRefused reject",
  "checks": ["CHK-133"],
  "profiles": ["default", "hand-written"],
  "apis": ["tasksOptionalAuth"],
  "steps": [
    {
      "title": "a visitor",
      "request": {
        "method": "GET",
        "path": "/welcome/v1/greeting"
      },
      "expect": {
        "status": 200,
        "body": {
          "signedIn": false
        }
      }
    },
    {
      "title": "a signed-in user",
      "request": {
        "method": "GET",
        "path": "/welcome/v1/greeting",
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "signedIn": true
        }
      }
    },
    {
      "title": "a refused credential, read as a visitor by default",
      "request": {
        "method": "GET",
        "path": "/welcome/v1/greeting",
        "headers": {
          "authorization": "Bearer seampact-refused-token"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "signedIn": false
        }
      }
    },
    {
      "title": "a refused credential under onRefused reject",
      "request": {
        "method": "GET",
        "path": "/welcome/v1/strict-greeting",
        "headers": {
          "authorization": "Bearer seampact-refused-token"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "code": "api.unauthenticated"
        }
      }
    },
    {
      "title": "a visitor under onRefused reject",
      "request": {
        "method": "GET",
        "path": "/welcome/v1/strict-greeting"
      },
      "expect": {
        "status": 200,
        "body": {
          "signedIn": false
        }
      }
    }
  ]
}
