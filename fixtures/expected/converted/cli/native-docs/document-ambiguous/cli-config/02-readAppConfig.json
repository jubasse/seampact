{
  "function": "readAppConfig",
  "args": [
    "<root>/seampact.config.yaml",
    "seampact.config.yaml",
    null
  ],
  "result": {
    "status": "read",
    "config": {
      "file": "<root>/seampact.config.yaml",
      "outDir": "<root>/__generated__",
      "sources": {
        "a": {
          "kind": "path",
          "directory": "<root>/a"
        }
      },
      "entries": [
        {
          "entry": {
            "id": "server",
            "use": "probe-server",
            "api": "tasks",
            "operations": {
              "include": [
                "health"
              ]
            },
            "artefacts": {
              "nativeDocs": true
            },
            "options": {
              "echo": true
            }
          },
          "root": "<root>/__generated__/server"
        }
      ]
    }
  }
}
