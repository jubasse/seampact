{
  "name": "@seampact/codegen-fastify",
  "description": "Generates a Fastify plugin per api that registers each contract route with its access, validation and reply checks around your handler map, on Fastify 5, validating with the zod or yup link you give or with Ajv validators it generates.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "runtime"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "seampact": {
    "role": "target"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*"
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@seampact/codegen-core": "workspace:*",
    "@seampact/spec": "workspace:*",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
