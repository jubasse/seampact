{
  "function": "readAppConfig",
  "args": [
    "<root>/app/seampact.config.yaml",
    "seampact.config.yaml"
  ],
  "result": {
    "status": "read",
    "config": {
      "file": "<root>/app/seampact.config.yaml",
      "outDir": "<root>/app/src/__generated__",
      "sources": {
        "notes": {
          "kind": "bundle",
          "bundle": {
            "git": {
              "url": "../git-source.git",
              "tag": "v1"
            },
            "integrity": "sha256-m1Dx5GL/JzlteMx5ojBeXbRHBV8Wx7YgA3+v5h4xLDs="
          }
        }
      },
      "entries": [
        {
          "entry": {
            "id": "types",
            "use": "@seampact/codegen-ts",
            "apis": [
              "notes"
            ]
          },
          "root": "<root>/app/src/__generated__/types"
        }
      ]
    }
  }
}
