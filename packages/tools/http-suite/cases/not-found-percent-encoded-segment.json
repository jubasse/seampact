{
  "id": "not-found-percent-encoded-segment",
  "title": "404 in the api format for a percent-encoded static segment under the base path",
  "checks": [],
  "profiles": ["default"],
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/%63hannels/10000000-0000-4000-8000-000000000001/tasks/20000000-0000-4000-8000-000000000001",
        "headers": {
          "authorization": "Bearer {{userToken}}"
        }
      },
      "expect": {
        "status": 404,
        "headers": {
          "content-type": {
            "contains": ["application/problem+json"]
          }
        },
        "body": {
          "code": "api.not_found"
        }
      }
    }
  ]
}
