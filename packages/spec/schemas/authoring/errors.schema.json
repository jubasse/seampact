{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "seampact errors catalogue",
  "description": "Error codes, declared once (ADR 0002 section 11). A name-keyed catalogue file.",
  "type": "object",
  "properties": {
    "$include": {
      "$ref": "common.schema.json#/$defs/include"
    }
  },
  "propertyNames": {
    "description": "an error code (ADR 0002 section 4)",
    "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|\\$include)$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599,
          "$comment": "ADR 0002 section 11"
        },
        "nature": {
          "$ref": "common.schema.json#/$defs/name",
          "$comment": "ADR 0002 section 11",
          "description": "A base nature or one of the 'natures' catalogue."
        },
        "family": {
          "$ref": "common.schema.json#/$defs/errorCode",
          "$comment": "ADR 0002 section 11",
          "description": "Groups codes in docs and clients."
        },
        "params": {
          "$ref": "node.schema.json#/$defs/fields",
          "$comment": "ADR 0002 section 11",
          "description": "A fields map or a schema name."
        },
        "example": {
          "$comment": "ADR 0002 section 11",
          "description": "The params."
        },
        "title": {
          "type": "string",
          "$comment": "ADR 0002 section 11"
        },
        "summary": {
          "$ref": "common.schema.json#/$defs/summary",
          "$comment": "ADR 0002 section 12"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/description",
          "$comment": "ADR 0002 section 12"
        },
        "$include": {
          "$ref": "common.schema.json#/$defs/include"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "$include": true
        },
        "required": [
          "$include"
        ]
      },
      "else": {
        "properties": {
          "status": true
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
