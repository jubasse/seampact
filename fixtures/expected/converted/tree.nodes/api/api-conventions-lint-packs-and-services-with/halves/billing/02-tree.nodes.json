  "lint": {
    "rules": {
      "seampact/redundant-maturity": {
        "severity": "disabled",
        "origin": {
          "layer": "pack:house",
          "pointer": "/lint/rules/seampact~1redundant-maturity"
        }
      },
      "seampact/credential-name": {
        "severity": "error",
        "origin": {
          "layer": "api",
          "pointer": "/lint/rules/seampact~1credential-name"
        }
      }
    },
    "allows": [
      {
        "rule": "seampact/subtree-exception",
        "at": {
          "layer": "api",
          "pointer": "/surfaces/app"
        },
        "reason": "Probes are public on purpose.",
        "subtree": false
      },
      {
        "rule": "seampact/redundant-maturity",
        "at": {
          "layer": "api",
          "pointer": "/surfaces/app/routes/invoices"
        },
        "reason": "Stated for the docs.",
        "subtree": true
      },
      {
        "rule": "seampact/credential-name",
        "at": {
          "layer": "api",
          "pointer": "/surfaces/app/routes/invoices/routes/list/query/apiKey?"
        },
        "reason": "A public key.",
        "subtree": false
      },
      {
        "rule": "seampact/unused-declaration",
        "at": {
          "layer": "api",
          "pointer": "/schemas/Invoice"
        },
        "reason": "Kept for the next version.",
        "subtree": false
      },
      {
        "rule": "seampact/credential-name",
        "at": {
          "layer": "api",
          "pointer": "/schemas/Invoice/properties/token"
        },
        "reason": "A public share token.",
        "subtree": false
      },
      {
        "rule": "seampact/credential-name",
        "at": {
          "layer": "api",
          "pointer": "/schemas/Invoice/properties/lines/items/properties/secret"
        },
        "reason": "A line label.",
        "subtree": false
      }
    ]
  }
