{
  "function": "readRunConfig",
  "args": [
    "<root>/seampact.config.yaml",
    "seampact.config.yaml",
    null
  ],
  "result": {
    "status": "read",
    "run": {
      "kind": "app",
      "config": {
        "file": "<root>/seampact.config.yaml",
        "outDir": "<root>/__generated__",
        "sources": {
          "a": {
            "kind": "path",
            "directory": "<root>/a"
          }
        },
        "entries": [
          {
            "entry": {
              "id": "types",
              "use": "probe-provider",
              "api": "tasks",
              "artefacts": {
                "bootCheck": {
                  "hooks": "off"
                }
              }
            },
            "root": "<root>/__generated__/types"
          }
        ]
      }
    }
  }
}
