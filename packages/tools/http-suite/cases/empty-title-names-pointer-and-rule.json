{
  "id": "empty-title-names-pointer-and-rule",
  "title": "400 for an empty title on create, naming the pointer and the rule",
  "checks": [],
  "profiles": ["default"],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/channels/10000000-0000-4000-8000-000000000001/tasks",
        "headers": {
          "authorization": "Bearer {{userToken}}",
          "idempotency-key": "{{uuid:create}}"
        },
        "body": {
          "title": ""
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "api.schema_invalid",
          "issues": [
            {
              "pointer": "/title",
              "rule": "minLength"
            }
          ]
        }
      }
    }
  ]
}
